{
  "GameName": "E06_PhysicsActions",
  "Cast": [
    {
      "ActorName": "PhysicsActor",
      "PrefabName": "Cube",
      "Properties": ["force=10"],
      "Script": [
        {
          "When": ["Collision(Obstacle)"],
          "Do": [
            "Push(this.force,0,1,0)",
            "PushTo(this.force,TargetActor.x,TargetActor.y,TargetActor.z)",
            "Torque(0,1,0)"
          ]
        }
      ]
    },
    {
      "ActorName": "TargetActor",
      "PrefabName": "Cube",
      "Position": [3, 0, 3]
    }
  ]
}
