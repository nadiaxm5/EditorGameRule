/* Common.uss - Shared styles for GameRule Editor */
/* Design System: Material Design 3 + Unity Dark Theme */

/* ═══════════════════════════════════════════
   ROOT & WINDOW BACKGROUNDS
   ═══════════════════════════════════════════ */

#unity-content-container {
    background-color: rgb(30, 30, 30); /* backgroundBase #1e1e1e */
}

/* ═══════════════════════════════════════════
   SCROLLVIEW
   ═══════════════════════════════════════════ */

ScrollView {
    background-color: rgb(37, 37, 38); /* panelBackground #252526 */
}

/* ═══════════════════════════════════════════
   LABELS
   ═══════════════════════════════════════════ */

Label {
    color: rgb(229, 231, 235); /* textPrimary #e5e7eb */
    font-size: 12px;
}

/* ═══════════════════════════════════════════
   TEXT FIELDS  (InspectorInputs from spec)
   ═══════════════════════════════════════════ */

TextField {
    background-color: rgb(30, 30, 30);  /* inputBackground #1e1e1e */
    color: rgb(255, 255, 255);
    border-left-color: rgb(68, 68, 68); /* borderLight #444444 */
    border-right-color: rgb(68, 68, 68);
    border-top-color: rgb(68, 68, 68);
    border-bottom-color: rgb(68, 68, 68);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    margin: 2px;
    font-size: 12px;
}

TextField:focus {
    border-left-color: rgb(208, 188, 255); /* primaryFixedDim #D0BCFF */
    border-right-color: rgb(208, 188, 255);
    border-top-color: rgb(208, 188, 255);
    border-bottom-color: rgb(208, 188, 255);
}

TextField > TextInput {
    background-color: rgb(30, 30, 30);
    color: rgb(255, 255, 255);
}

/* ═══════════════════════════════════════════
   BUTTONS
   ═══════════════════════════════════════════ */

Button {
    background-color: rgb(56, 56, 56);  /* hoverBackground #383838 */
    color: rgb(229, 231, 235);          /* textPrimary */
    border-left-color: rgb(26, 26, 26); /* borderDark #1a1a1a */
    border-right-color: rgb(26, 26, 26);
    border-top-color: rgb(26, 26, 26);
    border-bottom-color: rgb(26, 26, 26);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
    margin: 2px;
}

Button:hover {
    background-color: rgb(68, 68, 68); /* hoverBackgroundLighter #444444 */
}

Button:active {
    background-color: rgb(85, 85, 85); /* hoverBackgroundDarker #555555 */
}

Button:disabled {
    background-color: rgb(45, 45, 45);
    color: rgb(107, 114, 128); /* textMuted #6b7280 */
}

/* ── Shared purple palette ── */
.button-primary,
.button-success,
.list-item.list-item-selected,
.actor-list-item.actor-list-item--selected,
.fab-create {
    background-color: rgb(79, 55, 139);  /* light purple #4F378B */
    color: rgb(234, 221, 255);           /* primaryFixed #EADDFF */
    border-left-color: rgb(59, 39, 107); /* dark purple #3B276B */
    border-right-color: rgb(59, 39, 107);
    border-top-color: rgb(59, 39, 107);
    border-bottom-color: rgb(59, 39, 107);
}

.button-primary:hover,
.button-success:hover,
.list-item.list-item-selected:hover,
.actor-list-item.actor-list-item--selected:hover,
.fab-create:hover {
    background-color: rgb(96, 68, 165); /* light purple hover #6044A5 */
}

.button-primary:active,
.button-success:active,
.fab-create:active {
    background-color: rgb(59, 39, 107); /* dark purple #3B276B */
}

.button-primary > .unity-base-field__input {
    background-color: rgb(79, 55, 139);  /* light purple #4F378B */
    color: rgb(234, 221, 255);
    border-left-color: rgb(59, 39, 107);
    border-right-color: rgb(59, 39, 107);
    border-top-color: rgb(59, 39, 107);
    border-bottom-color: rgb(59, 39, 107);
}

.button-primary:hover > .unity-base-field__input {
    background-color: rgb(96, 68, 165); /* light purple hover #6044A5 */
}

.button-primary:active > .unity-base-field__input {
    background-color: rgb(59, 39, 107); /* dark purple #3B276B */
}

.button-primary .unity-base-popup-field__text {
    color: rgb(234, 221, 255);
}

.button-secondary {
    background-color: rgb(59, 39, 107); /* dark purple #3B276B */
    color: rgb(234, 221, 255);
    border-left-color: rgb(50, 31, 95);
    border-right-color: rgb(50, 31, 95);
    border-top-color: rgb(50, 31, 95);
    border-bottom-color: rgb(50, 31, 95);
}

.button-secondary:hover {
    background-color: rgb(72, 50, 125); /* dark purple hover #48327D */
}

.button-secondary:active {
    background-color: rgb(59, 39, 107);
}

/* ── Logical negation ── */
.button-negation {
    width: 38px;
    min-width: 38px;
    height: 22px;
    margin-right: 4px;
    flex-shrink: 0;
    background-color: rgb(52, 52, 52);
    color: rgb(185, 185, 185);
    border-left-color: rgb(75, 75, 75);
    border-right-color: rgb(75, 75, 75);
    border-top-color: rgb(75, 75, 75);
    border-bottom-color: rgb(75, 75, 75);
    font-size: 9px;
    -unity-font-style: bold;
}

.button-negation:hover {
    background-color: rgb(68, 68, 68);
    color: rgb(255, 255, 255);
}

.button-negation:active {
    background-color: rgb(85, 85, 85);
}

.button-negation:disabled {
    background-color: rgb(45, 45, 45);
    color: rgb(100, 100, 100);
    border-left-color: rgb(60, 60, 60);
    border-right-color: rgb(60, 60, 60);
    border-top-color: rgb(60, 60, 60);
    border-bottom-color: rgb(60, 60, 60);
}

.button-negation.button-negation--active {
    background-color: rgb(204, 0, 31); /* same red as the remove buttons */
    color: rgb(255, 255, 255);
    border-left-color: rgb(143, 0, 22);
    border-right-color: rgb(143, 0, 22);
    border-top-color: rgb(143, 0, 22);
    border-bottom-color: rgb(143, 0, 22);
}

.button-negation.button-negation--active:hover {
    background-color: rgb(226, 26, 54);
}

.button-negation.button-negation--active:active {
    background-color: rgb(168, 0, 25);
}

.condition-negated {
    border-left-width: 3px;
    border-left-color: rgb(204, 0, 31);
}

/* ── Destructive / trash ── */
.button-danger {
    background-color: rgb(204, 0, 31);   /* #CC001F */
    color: rgb(255, 255, 255);
    border-left-color: rgb(143, 0, 22);
    border-right-color: rgb(143, 0, 22);
    border-top-color: rgb(143, 0, 22);
    border-bottom-color: rgb(143, 0, 22);
}

.button-danger:hover {
    background-color: rgb(226, 26, 54);  /* #E21A36 */
}

.button-danger:active {
    background-color: rgb(168, 0, 25);
}

.button-danger-icon {
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 1px;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ── Rule conditions ── */
.button-condition,
.button-condition > .unity-base-field__input {
    background-color: rgb(5, 168, 170);  /* #05A8AA */
    color: rgb(255, 255, 255);
    border-left-color: rgb(3, 122, 124);
    border-right-color: rgb(3, 122, 124);
    border-top-color: rgb(3, 122, 124);
    border-bottom-color: rgb(3, 122, 124);
}

.button-condition:hover,
.button-condition:hover > .unity-base-field__input {
    background-color: rgb(22, 190, 192); /* #16BEC0 */
}

.button-condition:active,
.button-condition:active > .unity-base-field__input {
    background-color: rgb(4, 136, 138);
}

.button-condition .unity-base-popup-field__text {
    color: rgb(255, 255, 255);
}

/* ── Rule actions ── */
.button-action,
.button-action > .unity-base-field__input {
    background-color: rgb(248, 94, 37);  /* #F85E25 */
    color: rgb(255, 255, 255);
    border-left-color: rgb(182, 63, 18);
    border-right-color: rgb(182, 63, 18);
    border-top-color: rgb(182, 63, 18);
    border-bottom-color: rgb(182, 63, 18);
}

.button-action:hover,
.button-action:hover > .unity-base-field__input {
    background-color: rgb(255, 119, 70); /* #FF7746 */
}

.button-action:active,
.button-action:active > .unity-base-field__input {
    background-color: rgb(211, 72, 24);  /* #D34818 */
}

.button-action .unity-base-popup-field__text {
    color: rgb(255, 255, 255);
}

/* Dropdowns that visually match the spacing of the standard + Add Rule button. */
.rule-selector-dropdown {
    min-height: 27px;
}

.rule-selector-dropdown > .unity-base-field__input {
    min-height: 25px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
}

/* Button-backed rule dropdowns allow every open menu item to have a tooltip. */
.tooltip-popup-field {
    min-height: 27px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
    -unity-text-align: middle-center;
}

.tooltip-dropdown-menu {
    padding: 4px;
    background-color: rgb(43, 43, 43);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(90, 90, 90);
    border-right-color: rgb(90, 90, 90);
    border-top-color: rgb(90, 90, 90);
    border-bottom-color: rgb(90, 90, 90);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.tooltip-dropdown-option {
    min-height: 24px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 1px;
    margin-bottom: 1px;
    padding-left: 8px;
    padding-right: 8px;
    -unity-text-align: middle-left;
}

/* ── Property picker ── */
.button-property-picker,
.button-property-picker > .unity-base-field__input {
    background-color: rgb(255, 174, 3);  /* #FFAE03 */
    color: rgb(30, 30, 30);
    border-left-color: rgb(181, 121, 0);
    border-right-color: rgb(181, 121, 0);
    border-top-color: rgb(181, 121, 0);
    border-bottom-color: rgb(181, 121, 0);
    -unity-font-style: bold;
}

.button-property-picker:hover,
.button-property-picker:hover > .unity-base-field__input {
    background-color: rgb(255, 193, 61); /* #FFC13D */
    color: rgb(30, 30, 30);
}

.button-property-picker:active,
.button-property-picker:active > .unity-base-field__input {
    background-color: rgb(217, 146, 0);
}

.button-property-picker .unity-base-popup-field__text {
    color: rgb(30, 30, 30);
}

.button-property-picker .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(30, 30, 30);
}

/* ── Numeric values ── */
.button-number-picker,
.button-number-picker > .unity-base-field__input {
    background-color: rgb(100, 203, 118); /* #64CB76 */
    color: rgb(20, 45, 25);
    border-left-color: rgb(66, 153, 81);
    border-right-color: rgb(66, 153, 81);
    border-top-color: rgb(66, 153, 81);
    border-bottom-color: rgb(66, 153, 81);
    -unity-font-style: bold;
}

.button-number-picker:hover,
.button-number-picker:hover > .unity-base-field__input {
    background-color: rgb(121, 215, 137);
    color: rgb(20, 45, 25);
}

.button-number-picker:active,
.button-number-picker:active > .unity-base-field__input {
    background-color: rgb(76, 177, 94);
}

.button-number-picker .unity-base-popup-field__text {
    color: rgb(20, 45, 25);
}

.button-number-picker .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(20, 45, 25);
}

.numeric-stepper {
    min-height: 20px;
}

.numeric-stepper-field {
    width: 66px;
    min-width: 66px;
    margin-left: 1px;
    margin-right: 1px;
}

.numeric-stepper-field > .unity-base-field__input {
    min-height: 20px;
    background-color: rgb(30, 30, 30);
    color: rgb(255, 255, 255);
    border-left-color: rgb(68, 68, 68);
    border-right-color: rgb(68, 68, 68);
    border-top-color: rgb(68, 68, 68);
    border-bottom-color: rgb(68, 68, 68);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-left: 6px;
    padding-right: 6px;
}

.numeric-stepper-button {
    width: 18px;
    min-width: 18px;
    height: 18px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    font-size: 7px;
}

/* ── Action parameter builders ── */
.action-parameter-row {
    min-height: 28px;
    min-width: 140px;
    flex-direction: row;
    align-items: center;
    margin-right: 3px;
    margin-bottom: 4px;
}

.action-single-picker,
.action-scalar-control,
.action-expression-control,
.action-value-selection,
.action-expression-selection,
.action-expression-term {
    flex-direction: row;
    align-items: center;
}

.action-resource-picker {
    width: 160px;
    min-width: 160px;
    max-width: 160px;
    height: 24px;
    margin: 0;
    padding-left: 8px;
    padding-right: 8px;
    -unity-text-align: middle-left;
}

.action-picker-value-display {
    width: 150px;
    min-width: 150px;
    max-width: 150px;
    height: 24px;
    min-height: 24px;
    margin-left: 0;
    margin-right: 6px;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: rgb(30, 30, 30);
    color: rgb(229, 231, 235);
    border-left-color: rgb(68, 68, 68);
    border-right-color: rgb(68, 68, 68);
    border-top-color: rgb(68, 68, 68);
    border-bottom-color: rgb(68, 68, 68);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    -unity-text-align: middle-left;
    flex-shrink: 0;
}

.action-picker-value-display:hover {
    background-color: rgb(56, 56, 56);
    color: rgb(255, 255, 255);
}

.action-picker-value-display.action-empty-value {
    color: rgb(145, 145, 145);
    -unity-font-style: italic;
}

.action-scalar-control,
.action-expression-control {
    flex-grow: 1;
}

.action-value-picker {
    width: 184px;
    min-width: 184px;
    height: 28px;
    margin: 0;
    flex-shrink: 0;
}

.action-value-picker > .unity-base-field__input {
    min-width: 180px;
}

.action-value-selection,
.action-expression-selection {
    min-height: 24px;
    margin-left: 0;
    margin-right: 6px;
}

.action-value-selection {
    flex-shrink: 0;
}

.action-expression-selection {
    width: 280px;
    min-width: 280px;
    max-width: 280px;
    height: 30px;
    min-height: 30px;
    padding-left: 4px;
    padding-right: 4px;
    background-color: rgb(32, 32, 32);
    border-left-color: rgb(68, 68, 68);
    border-right-color: rgb(68, 68, 68);
    border-top-color: rgb(68, 68, 68);
    border-bottom-color: rgb(68, 68, 68);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    flex-shrink: 0;
}

.action-empty-expression {
    color: rgb(145, 145, 145);
    font-size: 10px;
    -unity-font-style: italic;
    margin-left: 5px;
}

.action-selected-value,
.action-legacy-value {
    min-width: 92px;
    max-width: 160px;
    height: 24px;
    min-height: 24px;
    margin: 0;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: rgb(30, 30, 30);
    color: rgb(229, 231, 235);
    border-left-color: rgb(68, 68, 68);
    border-right-color: rgb(68, 68, 68);
    border-top-color: rgb(68, 68, 68);
    border-bottom-color: rgb(68, 68, 68);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    -unity-text-align: middle-left;
}

.action-selected-value:hover,
.action-legacy-value:hover {
    background-color: rgb(56, 56, 56);
    color: rgb(255, 255, 255);
}

.action-legacy-value {
    color: rgb(190, 190, 190);
    -unity-font-style: italic;
}

.action-number-degree-suffix {
    position: absolute;
    right: 5px;
    top: 2px;
    bottom: 2px;
    width: 9px;
    min-width: 9px;
    margin: 0;
    padding: 0;
    color: rgb(229, 231, 235);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.action-number-value .numeric-stepper-field > .unity-base-field__input {
    padding-right: 15px;
}

.action-clear-value {
    width: 22px;
    min-width: 22px;
    height: 22px;
    margin-left: 4px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding: 0;
    font-size: 14px;
    flex-shrink: 0;
}

.action-operation-picker {
    width: 54px;
    min-width: 54px;
    height: 28px;
    margin-left: 6px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    flex-shrink: 0;
}

.action-operation-picker > .unity-base-field__input {
    min-width: 50px;
}

.action-expression-term {
    margin-right: 4px;
}

.action-term-operator {
    width: 46px;
    min-width: 46px;
    height: 24px;
    margin-left: 0;
    margin-right: 4px;
    margin-top: 0;
    margin-bottom: 0;
    flex-shrink: 0;
}

.action-term-operator > .unity-base-field__input {
    min-width: 42px;
    min-height: 24px;
}

.action-pending-operator {
    width: 46px;
    min-width: 46px;
    height: 24px;
    margin-right: 4px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    -unity-text-align: middle-center;
}

.action-number-value {
    flex-shrink: 0;
}

/* Rule Details has a narrow column: keep each parameter and its controls stacked. */
.rule-detail-action .action-parameter-row {
    min-width: 0;
    margin-right: 0;
    margin-bottom: 10px;
}

.rule-detail-action .action-single-picker,
.rule-detail-action .action-scalar-control {
    flex-direction: column;
    align-items: flex-start;
}

.rule-detail-action .action-picker-value-display,
.rule-detail-action .action-value-selection {
    margin-right: 0;
    margin-bottom: 5px;
}

.rule-detail-action .action-expression-control {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    min-width: 0;
}

.rule-detail-action .action-expression-selection {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    height: auto;
    min-height: 30px;
    flex-wrap: wrap;
    margin-right: 0;
    margin-bottom: 5px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.rule-detail-action .action-expression-term {
    margin-bottom: 3px;
}

/* ── Compare expression builder ── */
.compare-operand {
    margin-left: 4px;
    margin-right: 4px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 5px;
    padding-bottom: 5px;
    background-color: rgb(42, 42, 42);
    border-left-color: rgb(74, 74, 74);
    border-right-color: rgb(74, 74, 74);
    border-top-color: rgb(74, 74, 74);
    border-bottom-color: rgb(74, 74, 74);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.compare-operand-toolbar {
    height: 28px;
    min-height: 28px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.compare-operand-label {
    width: 70px;
    min-width: 70px;
    max-width: 70px;
    height: 28px;
    min-height: 28px;
    margin-right: 6px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgb(46, 46, 46);
    color: rgb(217, 217, 217);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.compare-value-picker {
    min-width: 0;
    height: 28px;
    margin: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.compare-value-picker > .unity-base-field__input {
    min-width: 0;
}

.compare-operation-dropdown {
    width: 54px;
    min-width: 54px;
    height: 28px;
    margin-left: 6px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    flex-shrink: 0;
}

.compare-operation-dropdown.tooltip-popup-field,
.compare-operator-dropdown.tooltip-popup-field,
.compare-term-operator.tooltip-popup-field {
    padding-left: 5px;
    padding-right: 5px;
}

.compare-operation-dropdown > .unity-base-field__input {
    min-width: 50px;
    padding-left: 7px;
    padding-right: 5px;
}

.compare-operator-container {
    width: 56px;
    min-width: 56px;
    flex-shrink: 0;
    align-self: stretch;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 7px;
    margin-bottom: 0;
}

.compare-operator-dropdown {
    width: 48px;
    min-width: 48px;
    height: 28px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    flex-shrink: 0;
}

.compare-operator-dropdown > .unity-base-field__input {
    min-width: 44px;
    padding-left: 6px;
    padding-right: 4px;
}

.keyboard-key-picker {
    width: 130px;
    min-width: 130px;
    height: 27px;
    flex-shrink: 0;
    -unity-text-align: middle-left;
}

.check-property-field {
    width: 150px;
    min-width: 150px;
    max-width: 150px;
    height: 22px;
    flex-shrink: 0;
}

.collision-tag-dropdown {
    width: 110px;
    min-width: 110px;
    max-width: 110px;
    flex-shrink: 0;
}

.compare-terms {
    height: 30px;
    min-height: 30px;
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
    padding-right: 4px;
    background-color: rgb(32, 32, 32);
    border-left-color: rgb(68, 68, 68);
    border-right-color: rgb(68, 68, 68);
    border-top-color: rgb(68, 68, 68);
    border-bottom-color: rgb(68, 68, 68);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.compare-terms-content {
    min-width: 0;
    height: 28px;
    min-height: 28px;
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
}

.compare-empty-expression {
    color: rgb(145, 145, 145);
    font-size: 10px;
    -unity-font-style: italic;
    margin-left: 5px;
}

.compare-term {
    flex-direction: row;
    align-items: center;
    margin-right: 4px;
    margin-bottom: 0;
}

.compare-term-operator {
    width: 46px;
    min-width: 46px;
    height: 24px;
    margin-left: 0;
    margin-right: 4px;
    margin-top: 0;
    margin-bottom: 0;
    flex-shrink: 0;
}

.compare-term-operator > .unity-base-field__input {
    min-width: 42px;
    min-height: 24px;
    padding-left: 7px;
    padding-right: 5px;
}

.compare-pending-operator {
    min-height: 24px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    -unity-text-align: middle-center;
}

.compare-property-term {
    min-width: 92px;
    max-width: 180px;
    height: 24px;
    min-height: 24px;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    background-color: rgb(30, 30, 30);
    border-left-color: rgb(68, 68, 68);
    border-right-color: rgb(68, 68, 68);
    border-top-color: rgb(68, 68, 68);
    border-bottom-color: rgb(68, 68, 68);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    color: rgb(229, 231, 235);
    -unity-text-align: middle-left;
}

.compare-property-term:hover {
    background-color: rgb(56, 56, 56);
    color: rgb(255, 255, 255);
}

.compare-legacy-term {
    min-width: 92px;
    max-width: 180px;
    height: 24px;
    min-height: 24px;
    padding-left: 7px;
    padding-right: 7px;
    background-color: rgb(30, 30, 30);
    color: rgb(229, 231, 235);
    border-left-color: rgb(68, 68, 68);
    border-right-color: rgb(68, 68, 68);
    border-top-color: rgb(68, 68, 68);
    border-bottom-color: rgb(68, 68, 68);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    -unity-text-align: middle-left;
}

.compare-remove-term {
    width: 24px;
    min-width: 24px;
    height: 24px;
    margin-left: 6px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    flex-shrink: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 1px;
    font-size: 14px;
}

/* ═══════════════════════════════════════════
   TOGGLE
   ═══════════════════════════════════════════ */

Toggle {
    margin-top: 5px;
    margin-bottom: 5px;
    margin-left: 2px;
    margin-right: 2px;
}

Toggle > Label {
    min-width: 100px;
    padding-left: 5px;
}

/* ═══════════════════════════════════════════
   FOLDOUT
   ═══════════════════════════════════════════ */

Foldout {
    margin-top: 5px;
    margin-bottom: 5px;
}

Foldout > Toggle {
    background-color: rgb(56, 56, 56);
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    padding-right: 5px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

Foldout > Toggle:hover {
    background-color: rgb(68, 68, 68);
}

/* ═══════════════════════════════════════════
   POPUP / DROPDOWN
   ═══════════════════════════════════════════ */

PopupField {
    background-color: rgb(30, 30, 30);
    border-left-color: rgb(68, 68, 68);
    border-right-color: rgb(68, 68, 68);
    border-top-color: rgb(68, 68, 68);
    border-bottom-color: rgb(68, 68, 68);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    margin: 2px;
}

/* ═══════════════════════════════════════════
   PANEL / SECTION CONTAINERS
   ═══════════════════════════════════════════ */

.panel-container {
    background-color: rgb(37, 37, 38); /* panelBackground */
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
    flex-grow: 1;
}

.panel-section {
    background-color: rgb(45, 45, 45); /* footerBackground #2d2d2d */
    border-left-color: rgb(26, 26, 26);
    border-right-color: rgb(26, 26, 26);
    border-top-color: rgb(26, 26, 26);
    border-bottom-color: rgb(26, 26, 26);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
    margin-top: 5px;
    margin-bottom: 5px;
}

.panel-header {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(229, 231, 235);
    margin-bottom: 10px;
}

/* ═══════════════════════════════════════════
   LIST ITEMS (legacy — used by old panels)
   ═══════════════════════════════════════════ */

.list-item {
    background-color: rgb(56, 56, 56);
    border-left-color: rgb(26, 26, 26);
    border-right-color: rgb(26, 26, 26);
    border-top-color: rgb(26, 26, 26);
    border-bottom-color: rgb(26, 26, 26);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
    margin-top: 3px;
    margin-bottom: 3px;
    flex-direction: row;
    align-items: center;
}

.list-item:hover {
    background-color: rgb(68, 68, 68);
}

.list-item-selected {
    color: rgb(234, 221, 255);          /* primaryFixed */
    border-left-color: rgb(59, 39, 107);
    border-right-color: rgb(59, 39, 107);
    border-top-color: rgb(59, 39, 107);
    border-bottom-color: rgb(59, 39, 107);
}

.actor-prefab-label { color: rgb(156, 163, 175); }
.actor-rule-count { color: rgb(204, 230, 255); }
.list-item-selected Label,
.list-item-selected .actor-prefab-label,
.list-item-selected .actor-rule-count { color: rgb(255, 255, 255); }

/* ═══════════════════════════════════════════
   ACTOR LIST ITEM  (Hierarchy window)
   ═══════════════════════════════════════════ */

.actor-list-item {
    background-color: transparent;
    transition-duration: 0.08s;
}

.actor-list-item:hover {
    background-color: rgb(56, 56, 56); /* hoverBackground #383838 */
}

.actor-list-item--selected > Label {
    color: rgb(234, 221, 255); /* primaryFixed */
}

/* 3-dot menu button */
.actor-menu-btn {
    width: 22px;
    height: 22px;
    font-size: 14px;
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    color: rgb(107, 114, 128); /* textMuted */
    padding: 0;
    margin: 0;
    -unity-text-align: middle-center;
    opacity: 0;
    transition-duration: 0.1s;
}

.actor-list-item:hover > .actor-menu-btn {
    opacity: 1;
}

.actor-menu-btn:hover {
    background-color: rgb(68, 68, 68);
    color: rgb(229, 231, 235);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

/* ═══════════════════════════════════════════
   FAB — Create Actor Button
   ═══════════════════════════════════════════ */

.fab-create {
    width: 40px;
    height: 40px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    color: rgb(234, 221, 255);           /* primaryFixed */
    border-left-color: rgb(59, 39, 107); /* borderPrimary */
    border-right-color: rgb(59, 39, 107);
    border-top-color: rgb(59, 39, 107);
    border-bottom-color: rgb(59, 39, 107);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    font-size: 20px;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

/* ═══════════════════════════════════════════
   HELP BOXES
   ═══════════════════════════════════════════ */

.help-box {
    background-color: rgb(45, 40, 60);    /* dark purple tint */
    border-left-color: rgb(96, 68, 165);  /* light purple */
    border-right-color: rgb(96, 68, 165);
    border-top-color: rgb(96, 68, 165);
    border-bottom-color: rgb(96, 68, 165);
    border-left-width: 4px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
    margin-top: 10px;
    margin-bottom: 10px;
    margin-left: 5px;
    margin-right: 5px;
}

.help-box-warning {
    background-color: rgb(55, 48, 40);
    border-left-color: rgb(220, 160, 58);
    border-right-color: rgb(220, 160, 58);
    border-top-color: rgb(220, 160, 58);
    border-bottom-color: rgb(220, 160, 58);
    border-left-width: 4px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.help-box-error {
    background-color: rgb(40, 35, 55);    /* dark purple tint */
    border-left-color: rgb(59, 39, 107);  /* dark purple */
    border-right-color: rgb(59, 39, 107);
    border-top-color: rgb(59, 39, 107);
    border-bottom-color: rgb(59, 39, 107);
    border-left-width: 4px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

/* ═══════════════════════════════════════════
   TOOLBAR
   ═══════════════════════════════════════════ */

Toolbar {
    background-color: rgb(51, 51, 51); /* toolbarBackground #333333 */
    border-bottom-width: 1px;
    border-bottom-color: rgb(26, 26, 26);
}

ToolbarButton {
    background-color: transparent;
    color: rgb(229, 231, 235);
    border-width: 0;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
}

ToolbarButton:hover {
    background-color: rgb(56, 56, 56);
}

ToolbarButton:active {
    background-color: rgb(68, 68, 68);
}

/* ═══════════════════════════════════════════
   SEPARATORS
   ═══════════════════════════════════════════ */

.separator {
    height: 1px;
    background-color: rgb(26, 26, 26);
    margin: 10px 0;
}

.separator-vertical {
    width: 1px;
    background-color: rgb(26, 26, 26);
    margin: 0 10px;
}

/* ═══════════════════════════════════════════
   SPACING UTILITIES
   ═══════════════════════════════════════════ */

.mt-5 { margin-top: 5px; }
.mt-10 { margin-top: 10px; }
.mt-20 { margin-top: 20px; }
.mb-5 { margin-bottom: 5px; }
.mb-10 { margin-bottom: 10px; }
.mb-20 { margin-bottom: 20px; }
.ml-5 { margin-left: 5px; }
.ml-10 { margin-left: 10px; }
.mr-5 { margin-right: 5px; }
.mr-10 { margin-right: 10px; }

.p-5 {
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    padding-right: 5px;
}
.p-10 {
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
}
.p-20 {
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    padding-right: 20px;
}

/* ═══════════════════════════════════════════
   FLEX UTILITIES
   ═══════════════════════════════════════════ */

.flex-row {
    flex-direction: row;
}

.flex-column {
    flex-direction: column;
}

.flex-grow {
    flex-grow: 1;
}

.justify-center {
    justify-content: center;
}

.align-center {
    align-items: center;
}

.space-between {
    justify-content: space-between;
}

/* ═══════════════════════════════════════════
   TEXT UTILITIES
   ═══════════════════════════════════════════ */

.text-center {
    -unity-text-align: middle-center;
}

.text-bold {
    -unity-font-style: bold;
}

.text-large {
    font-size: 16px;
}

.text-small {
    font-size: 10px;
}

.text-muted {
    color: rgb(107, 114, 128); /* textMuted #6b7280 */
}

/* Light Unity skin. Keep action/condition/selection colours, but use light neutral
   surfaces and dark text. The root class is updated when Unity changes skin. */
#unity-content-container.gamerule-light,
.gamerule-light #unity-content-container,
.gamerule-light,
.gamerule-light ScrollView,
.gamerule-light .panel-container {
    background-color: rgb(242, 242, 242);
}

.gamerule-light Label,
.gamerule-light .panel-header,
.gamerule-light ToolbarButton {
    color: rgb(35, 35, 35);
}

.gamerule-light .text-muted,
.gamerule-light .actor-menu-btn,
.gamerule-light Button:disabled {
    color: rgb(92, 92, 92);
}

.gamerule-light TextField,
.gamerule-light TextField > TextInput,
.gamerule-light PopupField,
.gamerule-light .numeric-stepper-field > .unity-base-field__input,
.gamerule-light .action-picker-value-display,
.gamerule-light .action-selected-value,
.gamerule-light .action-legacy-value,
.gamerule-light .compare-property-term,
.gamerule-light .compare-legacy-term {
    background-color: rgb(255, 255, 255);
    color: rgb(35, 35, 35);
    border-left-color: rgb(182, 182, 182);
    border-right-color: rgb(182, 182, 182);
    border-top-color: rgb(182, 182, 182);
    border-bottom-color: rgb(182, 182, 182);
}

.gamerule-light .unity-base-field__input,
.gamerule-light .unity-base-popup-field__text {
    color: rgb(35, 35, 35);
}

.gamerule-light .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(35, 35, 35);
}

.gamerule-light TextField:focus {
    border-left-color: rgb(79, 55, 139);
    border-right-color: rgb(79, 55, 139);
    border-top-color: rgb(79, 55, 139);
    border-bottom-color: rgb(79, 55, 139);
}

.gamerule-light Button,
.gamerule-light Foldout > Toggle,
.gamerule-light .list-item {
    background-color: rgb(226, 226, 226);
    color: rgb(35, 35, 35);
    border-left-color: rgb(182, 182, 182);
    border-right-color: rgb(182, 182, 182);
    border-top-color: rgb(182, 182, 182);
    border-bottom-color: rgb(182, 182, 182);
}

.gamerule-light Button:hover,
.gamerule-light Foldout > Toggle:hover,
.gamerule-light .list-item:hover,
.gamerule-light .actor-list-item:hover,
.gamerule-light ToolbarButton:hover,
.gamerule-light .actor-menu-btn:hover {
    background-color: rgb(211, 211, 211);
    color: rgb(35, 35, 35);
}

.gamerule-light Button:active,
.gamerule-light ToolbarButton:active {
    background-color: rgb(197, 197, 197);
}

.gamerule-light Button:disabled {
    background-color: rgb(234, 234, 234);
}

.gamerule-light .panel-section,
.gamerule-light .action-expression-selection,
.gamerule-light .compare-terms,
.gamerule-light .compare-operand,
.gamerule-light .compare-operand-label {
    background-color: rgb(250, 250, 250);
    color: rgb(35, 35, 35);
    border-left-color: rgb(182, 182, 182);
    border-right-color: rgb(182, 182, 182);
    border-top-color: rgb(182, 182, 182);
    border-bottom-color: rgb(182, 182, 182);
}

.gamerule-light .action-picker-value-display:hover,
.gamerule-light .action-selected-value:hover,
.gamerule-light .action-legacy-value:hover,
.gamerule-light .compare-property-term:hover {
    background-color: rgb(231, 231, 231);
    color: rgb(35, 35, 35);
}

.gamerule-light .action-empty-expression,
.gamerule-light .compare-empty-expression,
.gamerule-light .action-empty-value,
.gamerule-light .action-legacy-value {
    color: rgb(107, 107, 107);
}

.gamerule-light .action-number-degree-suffix {
    color: rgb(35, 35, 35);
}

.gamerule-light .tooltip-dropdown-menu {
    background-color: rgb(248, 248, 248);
    border-left-color: rgb(182, 182, 182);
    border-right-color: rgb(182, 182, 182);
    border-top-color: rgb(182, 182, 182);
    border-bottom-color: rgb(182, 182, 182);
}

.gamerule-light .help-box {
    background-color: rgb(237, 231, 250);
}
.gamerule-light .help-box-warning {
    background-color: rgb(255, 246, 223);
}
.gamerule-light .help-box-error {
    background-color: rgb(251, 231, 235);
}

.gamerule-light Toolbar {
    background-color: rgb(226, 226, 226);
    border-bottom-color: rgb(182, 182, 182);
}

.gamerule-light .separator,
.gamerule-light .separator-vertical {
    background-color: rgb(182, 182, 182);
}

/* Explicit accent rules take precedence over the neutral Button/field rules above. */
.gamerule-light .fab-create,
.gamerule-light .button-primary,
.gamerule-light .button-success,
.gamerule-light .list-item.list-item-selected,
.gamerule-light .actor-list-item.actor-list-item--selected {
    background-color: rgb(79, 55, 139);
    color: rgb(255, 255, 255);
}
.gamerule-light .fab-create:hover,
.gamerule-light .button-primary:hover,
.gamerule-light .button-success:hover,
.gamerule-light .list-item.list-item-selected:hover,
.gamerule-light .actor-list-item.actor-list-item--selected:hover {
    background-color: rgb(96, 68, 165);
    color: rgb(255, 255, 255);
}
.gamerule-light .button-secondary {
    background-color: rgb(59, 39, 107);
    color: rgb(255, 255, 255);
}
.gamerule-light .button-secondary:hover {
    background-color: rgb(72, 50, 125);
    color: rgb(255, 255, 255);
}
.gamerule-light .button-danger,
.gamerule-light .button-negation.button-negation--active {
    background-color: rgb(204, 0, 31);
    color: rgb(255, 255, 255);
}
.gamerule-light .button-danger:hover,
.gamerule-light .button-negation.button-negation--active:hover {
    background-color: rgb(226, 26, 54);
    color: rgb(255, 255, 255);
}
.gamerule-light .button-condition,
.gamerule-light .button-condition > .unity-base-field__input {
    background-color: rgb(5, 168, 170);
    color: rgb(30, 30, 30);
}
.gamerule-light .button-condition:hover,
.gamerule-light .button-condition:hover > .unity-base-field__input {
    background-color: rgb(22, 190, 192);
}
.gamerule-light .button-condition:active,
.gamerule-light .button-condition:active > .unity-base-field__input {
    background-color: rgb(4, 136, 138);
}
.gamerule-light .button-action,
.gamerule-light .button-action > .unity-base-field__input {
    background-color: rgb(248, 94, 37);
    color: rgb(30, 30, 30);
}
.gamerule-light .button-action:hover,
.gamerule-light .button-action:hover > .unity-base-field__input {
    background-color: rgb(255, 119, 70);
}
.gamerule-light .button-action:active,
.gamerule-light .button-action:active > .unity-base-field__input {
    background-color: rgb(211, 72, 24);
}
.gamerule-light .button-property-picker,
.gamerule-light .button-property-picker > .unity-base-field__input {
    background-color: rgb(255, 174, 3);
}
.gamerule-light .button-property-picker:hover,
.gamerule-light .button-property-picker:hover > .unity-base-field__input {
    background-color: rgb(255, 193, 61);
}
.gamerule-light .button-property-picker:active,
.gamerule-light .button-property-picker:active > .unity-base-field__input {
    background-color: rgb(217, 146, 0);
}
.gamerule-light .button-number-picker,
.gamerule-light .button-number-picker > .unity-base-field__input {
    background-color: rgb(100, 203, 118);
}
.gamerule-light .button-number-picker:hover,
.gamerule-light .button-number-picker:hover > .unity-base-field__input {
    background-color: rgb(121, 215, 137);
}
.gamerule-light .button-number-picker:active,
.gamerule-light .button-number-picker:active > .unity-base-field__input {
    background-color: rgb(76, 177, 94);
}
.gamerule-light .button-condition .unity-base-popup-field__text,
.gamerule-light .button-action .unity-base-popup-field__text {
    color: rgb(30, 30, 30);
}
.gamerule-light .button-condition .unity-base-popup-field__arrow,
.gamerule-light .button-action .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(30, 30, 30);
}
.gamerule-light .button-primary .unity-base-popup-field__text {
    color: rgb(255, 255, 255);
}
.gamerule-light .button-primary > .unity-base-field__input {
    color: rgb(255, 255, 255);
}
.gamerule-light .button-primary .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.gamerule-light .actor-list-item--selected > Label,
.gamerule-light .list-item-selected {
    color: rgb(255, 255, 255);
}
.gamerule-light .actor-prefab-label { color: rgb(92, 92, 92); }
.gamerule-light .actor-rule-count { color: rgb(34, 67, 97); }
.gamerule-light .list-item-selected Label,
.gamerule-light .list-item-selected .actor-prefab-label,
.gamerule-light .list-item-selected .actor-rule-count { color: rgb(255, 255, 255); }

.gamerule-light .button-danger:active,
.gamerule-light .button-negation.button-negation--active:active {
    background-color: rgb(168, 0, 25);
    color: rgb(255, 255, 255);
}

.gamerule-light .button-secondary:active,
.gamerule-light .fab-create:active,
.gamerule-light .button-primary:active {
    background-color: rgb(59, 39, 107);
    color: rgb(255, 255, 255);
}

/* Compact WHEN/DO overview. Editing controls live in Rule Details. */
.rule-overview-column {
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
}

.condition-overview {
    border-right-width: 1px;
    border-right-color: rgb(75, 72, 79);
}

.gamerule-light .condition-overview {
    border-right-color: rgb(190, 190, 190);
}

.rule-summary-row { margin-bottom: 6px; }

.rule-summary-card {
    flex-grow: 1;
    min-height: 36px;
    white-space: normal;
    -unity-text-align: middle-left;
    padding-left: 9px;
    padding-right: 9px;
}

.rule-summary-selected {
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-color: rgb(255, 174, 3);
    border-bottom-color: rgb(255, 174, 3);
    border-left-color: rgb(255, 174, 3);
    border-right-color: rgb(255, 174, 3);
}
