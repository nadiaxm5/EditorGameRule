/* Common.uss - Shared styles for GameRule Editor */

/* Root container */
#unity-content-container {
    background-color: rgb(56, 56, 56);
}

/* Tab bar styling */
#tab-bar {
    background-color: rgb(64, 64, 64);
    border-bottom-width: 1px;
    border-bottom-color: rgb(35, 35, 35);
}

.tab-button {
    background-color: rgb(76, 76, 76);
    color: rgb(210, 210, 210);
    border-radius: 0;
    margin: 0;
    padding-left: 15px;
    padding-right: 15px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-left-color: rgb(40, 40, 40);
    border-right-color: rgb(40, 40, 40);
    font-size: 12px;
    -unity-font-style: normal;
}

.tab-button:hover {
    background-color: rgb(90, 90, 90);
}

.tab-button:active {
    background-color: rgb(56, 56, 56);
}

/* Content container */
#content-container {
    background-color: rgb(56, 56, 56);
    padding: 10px;
}

/* Scroll view */
ScrollView {
    background-color: rgb(56, 56, 56);
}

/* Labels */
Label {
    color: rgb(210, 210, 210);
    font-size: 12px;
}

/* Text fields */
TextField {
    background-color: rgb(42, 42, 42);
    color: rgb(210, 210, 210);
    border-left-color: rgb(35, 35, 35);
    border-right-color: rgb(35, 35, 35);
    border-top-color: rgb(35, 35, 35);
    border-bottom-color: rgb(35, 35, 35);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    padding-right: 5px;
    margin: 2px;
}

TextField:focus {
    border-left-color: rgb(58, 121, 187);
    border-right-color: rgb(58, 121, 187);
    border-top-color: rgb(58, 121, 187);
    border-bottom-color: rgb(58, 121, 187);
}

TextField > TextInput {
    background-color: rgb(42, 42, 42);
    color: rgb(210, 210, 210);
}

/* Buttons */
Button {
    background-color: rgb(90, 90, 90);
    color: rgb(210, 210, 210);
    border-left-color: rgb(35, 35, 35);
    border-right-color: rgb(35, 35, 35);
    border-top-color: rgb(35, 35, 35);
    border-bottom-color: rgb(35, 35, 35);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
    margin: 2px;
}

Button:hover {
    background-color: rgb(105, 105, 105);
}

Button:active {
    background-color: rgb(75, 75, 75);
}

Button:disabled {
    background-color: rgb(60, 60, 60);
    color: rgb(120, 120, 120);
}

/* Primary button variant */
.button-primary {
    background-color: rgb(58, 121, 187);
    border-left-color: rgb(35, 75, 120);
    border-right-color: rgb(35, 75, 120);
    border-top-color: rgb(35, 75, 120);
    border-bottom-color: rgb(35, 75, 120);
}

.button-primary:hover {
    background-color: rgb(70, 135, 205);
}

.button-primary:active {
    background-color: rgb(45, 105, 165);
}

/* Danger button variant */
.button-danger {
    background-color: rgb(187, 58, 58);
    border-left-color: rgb(120, 35, 35);
    border-right-color: rgb(120, 35, 35);
    border-top-color: rgb(120, 35, 35);
    border-bottom-color: rgb(120, 35, 35);
}

.button-danger:hover {
    background-color: rgb(205, 70, 70);
}

.button-danger:active {
    background-color: rgb(165, 45, 45);
}

/* Success button variant */
.button-success {
    background-color: rgb(58, 187, 58);
    border-left-color: rgb(35, 120, 35);
    border-right-color: rgb(35, 120, 35);
    border-top-color: rgb(35, 120, 35);
    border-bottom-color: rgb(35, 120, 35);
}

.button-success:hover {
    background-color: rgb(70, 205, 70);
}

.button-success:active {
    background-color: rgb(45, 165, 45);
}

/* Toggle */
Toggle {
    margin-top: 5px;
    margin-bottom: 5px;
    margin-left: 2px;
    margin-right: 2px;
}

Toggle > Label {
    min-width: 100px;
    padding-left: 5px;
}

/* Foldout */
Foldout {
    margin-top: 5px;
    margin-bottom: 5px;
}

Foldout > Toggle {
    background-color: rgb(70, 70, 70);
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    padding-right: 5px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

Foldout > Toggle:hover {
    background-color: rgb(80, 80, 80);
}

/* Dropdown / Popup */
PopupField {
    background-color: rgb(42, 42, 42);
    border-left-color: rgb(35, 35, 35);
    border-right-color: rgb(35, 35, 35);
    border-top-color: rgb(35, 35, 35);
    border-bottom-color: rgb(35, 35, 35);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    margin: 2px;
}

/* Panel containers */
.panel-container {
    background-color: rgb(56, 56, 56);
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
    flex-grow: 1;
}

.panel-section {
    background-color: rgb(64, 64, 64);
    border-left-color: rgb(35, 35, 35);
    border-right-color: rgb(35, 35, 35);
    border-top-color: rgb(35, 35, 35);
    border-bottom-color: rgb(35, 35, 35);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
    margin-top: 5px;
    margin-bottom: 5px;
}

.panel-header {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(220, 220, 220);
    margin-bottom: 10px;
}

/* List items */
.list-item {
    background-color: rgb(70, 70, 70);
    border-left-color: rgb(35, 35, 35);
    border-right-color: rgb(35, 35, 35);
    border-top-color: rgb(35, 35, 35);
    border-bottom-color: rgb(35, 35, 35);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
    margin-top: 3px;
    margin-bottom: 3px;
    flex-direction: row;
    align-items: center;
}

.list-item:hover {
    background-color: rgb(80, 80, 80);
}

.list-item-selected {
    background-color: rgb(58, 121, 187);
    border-left-color: rgb(35, 75, 120);
    border-right-color: rgb(35, 75, 120);
    border-top-color: rgb(35, 75, 120);
    border-bottom-color: rgb(35, 75, 120);
}

.list-item-selected:hover {
    background-color: rgb(70, 135, 205);
}

/* Help boxes */
.help-box {
    background-color: rgb(64, 80, 64);
    border-left-color: rgb(58, 187, 58);
    border-right-color: rgb(58, 187, 58);
    border-top-color: rgb(58, 187, 58);
    border-bottom-color: rgb(58, 187, 58);
    border-left-width: 4px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
    margin-top: 10px;
    margin-bottom: 10px;
    margin-left: 5px;
    margin-right: 5px;
}

.help-box-warning {
    background-color: rgb(80, 72, 64);
    border-left-color: rgb(220, 160, 58);
    border-right-color: rgb(220, 160, 58);
    border-top-color: rgb(220, 160, 58);
    border-bottom-color: rgb(220, 160, 58);
    border-left-width: 4px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.help-box-error {
    background-color: rgb(80, 64, 64);
    border-left-color: rgb(187, 58, 58);
    border-right-color: rgb(187, 58, 58);
    border-top-color: rgb(187, 58, 58);
    border-bottom-color: rgb(187, 58, 58);
    border-left-width: 4px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

/* Toolbar styling */
Toolbar {
    background-color: rgb(70, 70, 70);
    border-bottom-width: 1px;
    border-bottom-color: rgb(35, 35, 35);
}

ToolbarButton {
    background-color: rgb(90, 90, 90);
    color: rgb(210, 210, 210);
    border-width: 0;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 15px;
    padding-right: 15px;
}

ToolbarButton:hover {
    background-color: rgb(105, 105, 105);
}

ToolbarButton:active {
    background-color: rgb(75, 75, 75);
}

/* Separators */
.separator {
    height: 1px;
    background-color: rgb(35, 35, 35);
    margin: 10px 0;
}

.separator-vertical {
    width: 1px;
    background-color: rgb(35, 35, 35);
    margin: 0 10px;
}

/* Spacing utilities */
.mt-5 { margin-top: 5px; }
.mt-10 { margin-top: 10px; }
.mt-20 { margin-top: 20px; }
.mb-5 { margin-bottom: 5px; }
.mb-10 { margin-bottom: 10px; }
.mb-20 { margin-bottom: 20px; }
.ml-5 { margin-left: 5px; }
.ml-10 { margin-left: 10px; }
.mr-5 { margin-right: 5px; }
.mr-10 { margin-right: 10px; }

.p-5 { 
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    padding-right: 5px;
}
.p-10 { 
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
}
.p-20 { 
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    padding-right: 20px;
}

/* Flex utilities */
.flex-row {
    flex-direction: row;
}

.flex-column {
    flex-direction: column;
}

.flex-grow {
    flex-grow: 1;
}

.justify-center {
    justify-content: center;
}

.align-center {
    align-items: center;
}

.space-between {
    justify-content: space-between;
}

/* Text utilities */
.text-center {
    -unity-text-align: middle-center;
}

.text-bold {
    -unity-font-style: bold;
}

.text-large {
    font-size: 16px;
}

.text-small {
    font-size: 10px;
}

.text-muted {
    color: rgb(150, 150, 150);
}