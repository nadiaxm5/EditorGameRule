/* Common.uss - Shared styles for GameRule Editor */
/* Design System: Material Design 3 + Unity Dark Theme */

/* ═══════════════════════════════════════════
   ROOT & WINDOW BACKGROUNDS
   ═══════════════════════════════════════════ */

#unity-content-container {
    background-color: rgb(30, 30, 30); /* backgroundBase #1e1e1e */
}

/* ═══════════════════════════════════════════
   SCROLLVIEW
   ═══════════════════════════════════════════ */

ScrollView {
    background-color: rgb(37, 37, 38); /* panelBackground #252526 */
}

/* ═══════════════════════════════════════════
   LABELS
   ═══════════════════════════════════════════ */

Label {
    color: rgb(229, 231, 235); /* textPrimary #e5e7eb */
    font-size: 12px;
}

/* ═══════════════════════════════════════════
   TEXT FIELDS  (InspectorInputs from spec)
   ═══════════════════════════════════════════ */

TextField {
    background-color: rgb(30, 30, 30);  /* inputBackground #1e1e1e */
    color: rgb(255, 255, 255);
    border-left-color: rgb(68, 68, 68); /* borderLight #444444 */
    border-right-color: rgb(68, 68, 68);
    border-top-color: rgb(68, 68, 68);
    border-bottom-color: rgb(68, 68, 68);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    margin: 2px;
    font-size: 12px;
}

TextField:focus {
    border-left-color: rgb(208, 188, 255); /* primaryFixedDim #D0BCFF */
    border-right-color: rgb(208, 188, 255);
    border-top-color: rgb(208, 188, 255);
    border-bottom-color: rgb(208, 188, 255);
}

TextField > TextInput {
    background-color: rgb(30, 30, 30);
    color: rgb(255, 255, 255);
}

/* ═══════════════════════════════════════════
   BUTTONS
   ═══════════════════════════════════════════ */

Button {
    background-color: rgb(56, 56, 56);  /* hoverBackground #383838 */
    color: rgb(229, 231, 235);          /* textPrimary */
    border-left-color: rgb(26, 26, 26); /* borderDark #1a1a1a */
    border-right-color: rgb(26, 26, 26);
    border-top-color: rgb(26, 26, 26);
    border-bottom-color: rgb(26, 26, 26);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
    margin: 2px;
}

Button:hover {
    background-color: rgb(68, 68, 68); /* hoverBackgroundLighter #444444 */
}

Button:active {
    background-color: rgb(85, 85, 85); /* hoverBackgroundDarker #555555 */
}

Button:disabled {
    background-color: rgb(45, 45, 45);
    color: rgb(107, 114, 128); /* textMuted #6b7280 */
}

/* ── Primary (Material Design 3 purple) ── */
.button-primary {
    background-color: rgb(79, 55, 139);  /* onPrimaryFixedVariant #4F378B */
    color: rgb(234, 221, 255);           /* primaryFixed #EADDFF */
    border-left-color: rgb(59, 39, 107); /* borderPrimary #3b276b */
    border-right-color: rgb(59, 39, 107);
    border-top-color: rgb(59, 39, 107);
    border-bottom-color: rgb(59, 39, 107);
}

.button-primary:hover {
    background-color: rgb(96, 68, 165); /* onPrimaryFixedVariantHover #6044A5 */
}

.button-primary:active {
    background-color: rgb(65, 45, 115);
}

/* ── Danger (dark purple) ── */
.button-danger {
    background-color: rgb(59, 39, 107);   /* borderPrimary #3b276b */
    color: rgb(208, 188, 255);            /* primaryFixedDim #D0BCFF */
    border-left-color: rgb(45, 28, 85);
    border-right-color: rgb(45, 28, 85);
    border-top-color: rgb(45, 28, 85);
    border-bottom-color: rgb(45, 28, 85);
}

.button-danger:hover {
    background-color: rgb(72, 50, 125);
}

.button-danger:active {
    background-color: rgb(50, 33, 95);
}

/* ── Success (light purple) ── */
.button-success {
    background-color: rgb(96, 68, 165);   /* onPrimaryFixedVariantHover #6044A5 */
    color: rgb(234, 221, 255);            /* primaryFixed #EADDFF */
    border-left-color: rgb(79, 55, 139);  /* onPrimaryFixedVariant #4F378B */
    border-right-color: rgb(79, 55, 139);
    border-top-color: rgb(79, 55, 139);
    border-bottom-color: rgb(79, 55, 139);
}

.button-success:hover {
    background-color: rgb(115, 85, 185);  /* lighter purple */
}

.button-success:active {
    background-color: rgb(79, 55, 139);
}

/* ═══════════════════════════════════════════
   TOGGLE
   ═══════════════════════════════════════════ */

Toggle {
    margin-top: 5px;
    margin-bottom: 5px;
    margin-left: 2px;
    margin-right: 2px;
}

Toggle > Label {
    min-width: 100px;
    padding-left: 5px;
}

/* ═══════════════════════════════════════════
   FOLDOUT
   ═══════════════════════════════════════════ */

Foldout {
    margin-top: 5px;
    margin-bottom: 5px;
}

Foldout > Toggle {
    background-color: rgb(56, 56, 56);
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    padding-right: 5px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

Foldout > Toggle:hover {
    background-color: rgb(68, 68, 68);
}

/* ═══════════════════════════════════════════
   POPUP / DROPDOWN
   ═══════════════════════════════════════════ */

PopupField {
    background-color: rgb(30, 30, 30);
    border-left-color: rgb(68, 68, 68);
    border-right-color: rgb(68, 68, 68);
    border-top-color: rgb(68, 68, 68);
    border-bottom-color: rgb(68, 68, 68);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    margin: 2px;
}

/* ═══════════════════════════════════════════
   PANEL / SECTION CONTAINERS
   ═══════════════════════════════════════════ */

.panel-container {
    background-color: rgb(37, 37, 38); /* panelBackground */
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
    flex-grow: 1;
}

.panel-section {
    background-color: rgb(45, 45, 45); /* footerBackground #2d2d2d */
    border-left-color: rgb(26, 26, 26);
    border-right-color: rgb(26, 26, 26);
    border-top-color: rgb(26, 26, 26);
    border-bottom-color: rgb(26, 26, 26);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
    margin-top: 5px;
    margin-bottom: 5px;
}

.panel-header {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(229, 231, 235);
    margin-bottom: 10px;
}

/* ═══════════════════════════════════════════
   LIST ITEMS (legacy — used by old panels)
   ═══════════════════════════════════════════ */

.list-item {
    background-color: rgb(56, 56, 56);
    border-left-color: rgb(26, 26, 26);
    border-right-color: rgb(26, 26, 26);
    border-top-color: rgb(26, 26, 26);
    border-bottom-color: rgb(26, 26, 26);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
    margin-top: 3px;
    margin-bottom: 3px;
    flex-direction: row;
    align-items: center;
}

.list-item:hover {
    background-color: rgb(68, 68, 68);
}

.list-item-selected {
    background-color: rgb(79, 55, 139); /* onPrimaryFixedVariant */
    color: rgb(234, 221, 255);          /* primaryFixed */
    border-left-color: rgb(59, 39, 107);
    border-right-color: rgb(59, 39, 107);
    border-top-color: rgb(59, 39, 107);
    border-bottom-color: rgb(59, 39, 107);
}

.list-item-selected:hover {
    background-color: rgb(96, 68, 165); /* onPrimaryFixedVariantHover */
}

/* ═══════════════════════════════════════════
   ACTOR LIST ITEM  (Hierarchy window)
   ═══════════════════════════════════════════ */

.actor-list-item {
    background-color: transparent;
    transition-duration: 0.08s;
}

.actor-list-item:hover {
    background-color: rgb(56, 56, 56); /* hoverBackground #383838 */
}

.actor-list-item--selected {
    background-color: rgb(79, 55, 139); /* onPrimaryFixedVariant #4F378B */
}

.actor-list-item--selected:hover {
    background-color: rgb(96, 68, 165); /* onPrimaryFixedVariantHover */
}

.actor-list-item--selected > Label {
    color: rgb(234, 221, 255); /* primaryFixed */
}

/* 3-dot menu button */
.actor-menu-btn {
    width: 22px;
    height: 22px;
    font-size: 14px;
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    color: rgb(107, 114, 128); /* textMuted */
    padding: 0;
    margin: 0;
    -unity-text-align: middle-center;
    opacity: 0;
    transition-duration: 0.1s;
}

.actor-list-item:hover > .actor-menu-btn {
    opacity: 1;
}

.actor-menu-btn:hover {
    background-color: rgb(68, 68, 68);
    color: rgb(229, 231, 235);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

/* ═══════════════════════════════════════════
   FAB — Create Actor Button
   ═══════════════════════════════════════════ */

.fab-create {
    width: 40px;
    height: 40px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    background-color: rgb(79, 55, 139);  /* onPrimaryFixedVariant */
    color: rgb(234, 221, 255);           /* primaryFixed */
    border-left-color: rgb(59, 39, 107); /* borderPrimary */
    border-right-color: rgb(59, 39, 107);
    border-top-color: rgb(59, 39, 107);
    border-bottom-color: rgb(59, 39, 107);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    font-size: 20px;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.fab-create:hover {
    background-color: rgb(96, 68, 165); /* onPrimaryFixedVariantHover */
}

.fab-create:active {
    background-color: rgb(65, 45, 115);
}

/* ═══════════════════════════════════════════
   HELP BOXES
   ═══════════════════════════════════════════ */

.help-box {
    background-color: rgb(45, 40, 60);    /* dark purple tint */
    border-left-color: rgb(96, 68, 165);  /* light purple */
    border-right-color: rgb(96, 68, 165);
    border-top-color: rgb(96, 68, 165);
    border-bottom-color: rgb(96, 68, 165);
    border-left-width: 4px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
    margin-top: 10px;
    margin-bottom: 10px;
    margin-left: 5px;
    margin-right: 5px;
}

.help-box-warning {
    background-color: rgb(55, 48, 40);
    border-left-color: rgb(220, 160, 58);
    border-right-color: rgb(220, 160, 58);
    border-top-color: rgb(220, 160, 58);
    border-bottom-color: rgb(220, 160, 58);
    border-left-width: 4px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.help-box-error {
    background-color: rgb(40, 35, 55);    /* dark purple tint */
    border-left-color: rgb(59, 39, 107);  /* dark purple */
    border-right-color: rgb(59, 39, 107);
    border-top-color: rgb(59, 39, 107);
    border-bottom-color: rgb(59, 39, 107);
    border-left-width: 4px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

/* ═══════════════════════════════════════════
   TOOLBAR
   ═══════════════════════════════════════════ */

Toolbar {
    background-color: rgb(51, 51, 51); /* toolbarBackground #333333 */
    border-bottom-width: 1px;
    border-bottom-color: rgb(26, 26, 26);
}

ToolbarButton {
    background-color: transparent;
    color: rgb(229, 231, 235);
    border-width: 0;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
}

ToolbarButton:hover {
    background-color: rgb(56, 56, 56);
}

ToolbarButton:active {
    background-color: rgb(68, 68, 68);
}

/* ═══════════════════════════════════════════
   SEPARATORS
   ═══════════════════════════════════════════ */

.separator {
    height: 1px;
    background-color: rgb(26, 26, 26);
    margin: 10px 0;
}

.separator-vertical {
    width: 1px;
    background-color: rgb(26, 26, 26);
    margin: 0 10px;
}

/* ═══════════════════════════════════════════
   SPACING UTILITIES
   ═══════════════════════════════════════════ */

.mt-5 { margin-top: 5px; }
.mt-10 { margin-top: 10px; }
.mt-20 { margin-top: 20px; }
.mb-5 { margin-bottom: 5px; }
.mb-10 { margin-bottom: 10px; }
.mb-20 { margin-bottom: 20px; }
.ml-5 { margin-left: 5px; }
.ml-10 { margin-left: 10px; }
.mr-5 { margin-right: 5px; }
.mr-10 { margin-right: 10px; }

.p-5 {
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    padding-right: 5px;
}
.p-10 {
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
}
.p-20 {
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    padding-right: 20px;
}

/* ═══════════════════════════════════════════
   FLEX UTILITIES
   ═══════════════════════════════════════════ */

.flex-row {
    flex-direction: row;
}

.flex-column {
    flex-direction: column;
}

.flex-grow {
    flex-grow: 1;
}

.justify-center {
    justify-content: center;
}

.align-center {
    align-items: center;
}

.space-between {
    justify-content: space-between;
}

/* ═══════════════════════════════════════════
   TEXT UTILITIES
   ═══════════════════════════════════════════ */

.text-center {
    -unity-text-align: middle-center;
}

.text-bold {
    -unity-font-style: bold;
}

.text-large {
    font-size: 16px;
}

.text-small {
    font-size: 10px;
}

.text-muted {
    color: rgb(107, 114, 128); /* textMuted #6b7280 */
}