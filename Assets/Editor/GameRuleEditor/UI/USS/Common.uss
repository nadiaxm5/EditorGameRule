/* Common.uss - Shared styles for GameRule Editor */
/* Neutral surfaces and semantic accents for GameRule Studio. */

/* ═══════════════════════════════════════════
   ROOT & WINDOW BACKGROUNDS
   ═══════════════════════════════════════════ */

#unity-content-container {
    background-color: rgb(30, 30, 30);
}

/* ═══════════════════════════════════════════
   SCROLLVIEW
   ═══════════════════════════════════════════ */

ScrollView {
    background-color: rgb(37, 37, 37);
}

/* ═══════════════════════════════════════════
   LABELS
   ═══════════════════════════════════════════ */

Label {
    color: rgb(230, 230, 230);
    font-size: 12px;
}

/* ═══════════════════════════════════════════
   TEXT FIELDS  (InspectorInputs from spec)
   ═══════════════════════════════════════════ */

TextField {
    background-color: rgb(56, 56, 56);
    color: rgb(230, 230, 230);
    border-left-color: rgb(66, 66, 66);
    border-right-color: rgb(66, 66, 66);
    border-top-color: rgb(66, 66, 66);
    border-bottom-color: rgb(66, 66, 66);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    margin: 2px;
    font-size: 12px;
}

TextField:focus {
    border-left-color: rgb(161, 138, 224);
    border-right-color: rgb(161, 138, 224);
    border-top-color: rgb(161, 138, 224);
    border-bottom-color: rgb(161, 138, 224);
}

TextField > TextInput {
    background-color: rgb(56, 56, 56);
    color: rgb(230, 230, 230);
}

/* ═══════════════════════════════════════════
   BUTTONS
   ═══════════════════════════════════════════ */

Button {
    background-color: rgb(51, 51, 51);
    color: rgb(230, 230, 230);
    border-left-color: rgb(66, 66, 66);
    border-right-color: rgb(66, 66, 66);
    border-top-color: rgb(66, 66, 66);
    border-bottom-color: rgb(66, 66, 66);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
    margin: 2px;
}

Button:hover {
    background-color: rgb(56, 56, 56);
}

Button:active {
    background-color: rgb(37, 37, 37);
}

Button:disabled {
    background-color: rgb(51, 51, 51);
    color: rgb(181, 181, 181);
}

/* ── Shared purple palette ── */
.button-primary,
.button-success,
.list-item.list-item-selected,
.actor-list-item.actor-list-item--selected,
.fab-create {
    background-color: rgb(51, 51, 51);
    color: rgb(161, 138, 224);
    border-left-color: rgb(161, 138, 224);
    border-right-color: rgb(161, 138, 224);
    border-top-color: rgb(161, 138, 224);
    border-bottom-color: rgb(161, 138, 224);
}

.button-primary:hover,
.button-success:hover,
.list-item.list-item-selected:hover,
.actor-list-item.actor-list-item--selected:hover,
.fab-create:hover {
    background-color: rgb(56, 56, 56);
}

.button-primary:active,
.button-success:active,
.fab-create:active {
    background-color: rgb(37, 37, 37);
}

.button-primary > .unity-base-field__input {
    background-color: rgb(51, 51, 51);
    color: rgb(161, 138, 224);
    border-left-color: rgb(161, 138, 224);
    border-right-color: rgb(161, 138, 224);
    border-top-color: rgb(161, 138, 224);
    border-bottom-color: rgb(161, 138, 224);
}

.button-primary:hover > .unity-base-field__input {
    background-color: rgb(56, 56, 56);
}

.button-primary:active > .unity-base-field__input {
    background-color: rgb(37, 37, 37);
}

.button-primary .unity-base-popup-field__text {
    color: rgb(161, 138, 224);
}

.button-secondary {
    background-color: rgb(51, 51, 51);
    color: rgb(161, 138, 224);
    border-left-color: rgb(66, 66, 66);
    border-right-color: rgb(66, 66, 66);
    border-top-color: rgb(66, 66, 66);
    border-bottom-color: rgb(66, 66, 66);
}

.button-secondary:hover {
    background-color: rgb(56, 56, 56);
}

.button-secondary:active {
    background-color: rgb(37, 37, 37);
}

/* ── Logical negation ── */
.button-negation {
    width: 38px;
    min-width: 38px;
    height: 22px;
    margin-right: 4px;
    flex-shrink: 0;
    background-color: rgb(52, 52, 52);
    color: rgb(185, 185, 185);
    border-left-color: rgb(75, 75, 75);
    border-right-color: rgb(75, 75, 75);
    border-top-color: rgb(75, 75, 75);
    border-bottom-color: rgb(75, 75, 75);
    font-size: 9px;
    -unity-font-style: bold;
}

.button-negation:hover {
    background-color: rgb(68, 68, 68);
    color: rgb(255, 255, 255);
}

.button-negation:active {
    background-color: rgb(85, 85, 85);
}

.button-negation:disabled {
    background-color: rgb(45, 45, 45);
    color: rgb(100, 100, 100);
    border-left-color: rgb(60, 60, 60);
    border-right-color: rgb(60, 60, 60);
    border-top-color: rgb(60, 60, 60);
    border-bottom-color: rgb(60, 60, 60);
}

.button-negation.button-negation--active {
    background-color: rgb(204, 0, 31);
    color: rgb(255, 255, 255);
    border-left-color: rgb(143, 0, 22);
    border-right-color: rgb(143, 0, 22);
    border-top-color: rgb(143, 0, 22);
    border-bottom-color: rgb(143, 0, 22);
}

.button-negation.button-negation--active:hover {
    background-color: rgb(226, 26, 54);
}

.button-negation.button-negation--active:active {
    background-color: rgb(168, 0, 25);
}

.condition-negated {
    border-left-width: 3px;
    border-left-color: rgb(204, 0, 31);
}

/* ── Destructive controls ── */
.button-danger {
    background-color: transparent;
    color: rgb(181, 181, 181);
    border-left-color: transparent;
    border-right-color: transparent;
    border-top-color: transparent;
    border-bottom-color: transparent;
}

.gamerule-light .button-danger {
    background-color: transparent;
    color: rgb(92, 92, 92);
}

.button-danger:focus,
.gamerule-light .button-danger:focus {
    border-left-color: rgb(161, 138, 224);
    border-right-color: rgb(161, 138, 224);
    border-top-color: rgb(161, 138, 224);
    border-bottom-color: rgb(161, 138, 224);
}

.button-danger:hover,
.gamerule-light .button-danger:hover {
    background-color: rgb(222, 112, 120);
    color: rgb(30, 30, 30);
}

.button-danger:active,
.gamerule-light .button-danger:active {
    background-color: rgb(194, 87, 97);
    color: rgb(30, 30, 30);
}

.button-danger:disabled,
.gamerule-light .button-danger:disabled {
    background-color: transparent;
    color: rgb(107, 114, 128);
}

.button-danger-icon {
    width: 28px;
    min-width: 28px;
    height: 26px;
    flex-shrink: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 1px;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ── Rule conditions ── */
.button-condition,
.button-condition > .unity-base-field__input {
    background-color: rgb(51, 51, 51);
    color: rgb(56, 185, 207);
    border-left-color: rgb(56, 185, 207);
    border-right-color: rgb(56, 185, 207);
    border-top-color: rgb(56, 185, 207);
    border-bottom-color: rgb(56, 185, 207);
}

.button-condition:hover,
.button-condition:hover > .unity-base-field__input {
    background-color: rgb(56, 56, 56);
}

.button-condition:active,
.button-condition:active > .unity-base-field__input {
    background-color: rgb(37, 37, 37);
}

.button-condition .unity-base-popup-field__text {
    color: rgb(56, 185, 207);
}

/* ── Rule actions ── */
.button-action,
.button-action > .unity-base-field__input {
    background-color: rgb(51, 51, 51);
    color: rgb(240, 153, 89);
    border-left-color: rgb(240, 153, 89);
    border-right-color: rgb(240, 153, 89);
    border-top-color: rgb(240, 153, 89);
    border-bottom-color: rgb(240, 153, 89);
}

.button-action:hover,
.button-action:hover > .unity-base-field__input {
    background-color: rgb(56, 56, 56);
}

.button-action:active,
.button-action:active > .unity-base-field__input {
    background-color: rgb(37, 37, 37);
}

.button-action .unity-base-popup-field__text {
    color: rgb(240, 153, 89);
}

/* Dropdowns that visually match the spacing of the standard + Add Rule button. */
.rule-selector-dropdown {
    min-height: 27px;
}

.rule-selector-dropdown > .unity-base-field__input {
    min-height: 25px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
}

/* Button-backed rule dropdowns allow every open menu item to have a tooltip. */
.tooltip-popup-field {
    min-height: 27px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
    -unity-text-align: middle-center;
}

.tooltip-dropdown-menu {
    padding: 4px;
    background-color: rgb(51, 51, 51);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(66, 66, 66);
    border-right-color: rgb(66, 66, 66);
    border-top-color: rgb(66, 66, 66);
    border-bottom-color: rgb(66, 66, 66);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.tooltip-dropdown-option {
    min-height: 24px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 1px;
    margin-bottom: 1px;
    padding-left: 8px;
    padding-right: 8px;
    -unity-text-align: middle-left;
}

/* ── Property picker ── */
.button-property-picker,
.button-property-picker > .unity-base-field__input {
    background-color: rgb(51, 51, 51);
    color: rgb(217, 182, 92);
    border-left-color: rgb(217, 182, 92);
    border-right-color: rgb(217, 182, 92);
    border-top-color: rgb(217, 182, 92);
    border-bottom-color: rgb(217, 182, 92);
    -unity-font-style: bold;
}

.button-property-picker:hover,
.button-property-picker:hover > .unity-base-field__input {
    background-color: rgb(56, 56, 56);
    color: rgb(217, 182, 92);
}

.button-property-picker:active,
.button-property-picker:active > .unity-base-field__input {
    background-color: rgb(37, 37, 37);
}

.button-property-picker .unity-base-popup-field__text {
    color: rgb(217, 182, 92);
}

.button-property-picker .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(217, 182, 92);
}

/* ── Numeric values ── */
.button-number-picker,
.button-number-picker > .unity-base-field__input {
    background-color: rgb(51, 51, 51);
    color: rgb(101, 185, 155);
    border-left-color: rgb(101, 185, 155);
    border-right-color: rgb(101, 185, 155);
    border-top-color: rgb(101, 185, 155);
    border-bottom-color: rgb(101, 185, 155);
    -unity-font-style: bold;
}

.button-number-picker:hover,
.button-number-picker:hover > .unity-base-field__input {
    background-color: rgb(56, 56, 56);
    color: rgb(101, 185, 155);
}

.button-number-picker:active,
.button-number-picker:active > .unity-base-field__input {
    background-color: rgb(37, 37, 37);
}

.button-number-picker .unity-base-popup-field__text {
    color: rgb(101, 185, 155);
}

.button-number-picker .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(101, 185, 155);
}

.numeric-stepper {
    min-height: 20px;
}

.numeric-stepper-field {
    width: 66px;
    min-width: 66px;
    margin-left: 1px;
    margin-right: 1px;
}

.numeric-stepper-button {
    width: 18px;
    min-width: 18px;
    height: 18px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    font-size: 7px;
}

/* ── Action parameter builders ── */
.action-parameter-row {
    min-height: 28px;
    min-width: 140px;
    flex-direction: row;
    align-items: center;
    margin-right: 3px;
    margin-bottom: 4px;
}

.action-single-picker,
.action-scalar-control,
.action-expression-control,
.action-value-selection,
.action-expression-selection,
.action-expression-term {
    flex-direction: row;
    align-items: center;
}

.action-resource-picker {
    width: 160px;
    min-width: 160px;
    max-width: 160px;
    height: 24px;
    margin: 0;
    padding-left: 8px;
    padding-right: 8px;
    -unity-text-align: middle-left;
}

.action-picker-value-display {
    width: 150px;
    min-width: 150px;
    max-width: 150px;
    margin-left: 0;
    margin-right: 6px;
    margin-top: 0;
    margin-bottom: 0;
    flex-shrink: 0;
}

.action-picker-value-display.action-empty-value {
    color: rgb(181, 181, 181);
    -unity-font-style: italic;
}

.action-scalar-control,
.action-expression-control {
    flex-grow: 1;
}

.action-value-picker {
    width: 184px;
    min-width: 184px;
    height: 28px;
    margin: 0;
    flex-shrink: 0;
}

.action-value-picker > .unity-base-field__input {
    min-width: 180px;
}

.action-value-selection,
.action-expression-selection {
    min-height: 24px;
    margin-left: 0;
    margin-right: 6px;
}

.action-value-selection {
    flex-shrink: 0;
}

.action-expression-selection {
    width: 280px;
    min-width: 280px;
    max-width: 280px;
    height: 30px;
    min-height: 30px;
    padding-left: 4px;
    padding-right: 4px;
    background-color: rgb(37, 37, 37);
    border-left-color: rgb(66, 66, 66);
    border-right-color: rgb(66, 66, 66);
    border-top-color: rgb(66, 66, 66);
    border-bottom-color: rgb(66, 66, 66);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    flex-shrink: 0;
}

.action-empty-expression {
    color: rgb(181, 181, 181);
    font-size: 10px;
    -unity-font-style: italic;
    margin-left: 5px;
}

.action-selected-value,
.action-legacy-value {
    min-width: 92px;
    max-width: 160px;
    margin: 0;
}

.action-number-degree-suffix {
    position: absolute;
    right: 5px;
    top: 2px;
    bottom: 2px;
    width: 9px;
    min-width: 9px;
    margin: 0;
    padding: 0;
    color: rgb(230, 230, 230);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.action-number-value .numeric-stepper-field > .unity-base-field__input {
    padding-right: 15px;
}

.action-clear-value {
    width: 24px;
    min-width: 24px;
    height: 24px;
    margin-left: 4px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 1px;
    font-size: 14px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.action-operation-picker {
    width: 66px;
    min-width: 66px;
    height: 28px;
    margin-left: 6px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    flex-shrink: 0;
}

.action-operation-picker > .unity-base-field__input {
    min-width: 0;
    padding-left: 6px;
    padding-right: 6px;
}

.action-expression-toolbar {
    flex-direction: row;
    align-items: center;
}

.action-expression-term {
    margin-right: 4px;
}

.action-term-operator {
    width: 46px;
    min-width: 46px;
    height: 24px;
    margin-left: 0;
    margin-right: 4px;
    margin-top: 0;
    margin-bottom: 0;
    flex-shrink: 0;
}

.action-term-operator > .unity-base-field__input {
    min-width: 42px;
    min-height: 24px;
}

.action-pending-operator {
    width: 46px;
    min-width: 46px;
    height: 24px;
    margin-right: 4px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    -unity-text-align: middle-center;
}

.action-number-value {
    flex-shrink: 0;
}

/* Rule Details has a narrow column: keep each parameter and its controls stacked. */
.rule-detail-action .action-parameter-row {
    min-width: 0;
    margin-right: 0;
    margin-bottom: 10px;
    flex-wrap: wrap;
}

.rule-detail-action .action-single-picker,
.rule-detail-action .action-scalar-control {
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    max-width: 100%;
}

.rule-detail-action .action-picker-value-display,
.rule-detail-action .action-value-selection {
    margin-right: 0;
    margin-bottom: 5px;
}

.rule-detail-action .action-expression-parameter-row {
    flex-wrap: wrap;
}

.rule-detail-action .action-expression-control {
    flex-direction: column;
    align-items: stretch;
    flex-basis: 184px;
    min-width: 0;
    max-width: 100%;
}

.rule-detail-action .action-expression-toolbar {
    flex-wrap: wrap;
    min-width: 0;
}

.rule-detail-action .action-expression-toolbar .action-value-picker {
    max-width: 100%;
    min-width: 0;
    margin-right: 6px;
    margin-bottom: 4px;
}

.rule-detail-action .action-expression-toolbar .action-value-picker > .unity-base-field__input {
    min-width: 0;
}

.rule-detail-action .action-expression-toolbar .action-operation-picker {
    margin-left: 0;
    margin-bottom: 4px;
}

.rule-detail-action .action-expression-control .action-expression-selection {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    height: auto;
    min-height: 30px;
    flex-wrap: wrap;
    margin-right: 0;
    margin-bottom: 5px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.rule-detail-action .action-expression-term {
    min-width: 0;
    max-width: 100%;
    margin-bottom: 3px;
}

/* ── Compare expression builder ── */
.compare-operand {
    margin-left: 4px;
    margin-right: 4px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 5px;
    padding-bottom: 5px;
    background-color: rgb(51, 51, 51);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.compare-operand-toolbar {
    height: 28px;
    min-height: 28px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.compare-operand-label {
    width: 70px;
    min-width: 70px;
    max-width: 70px;
    height: 28px;
    min-height: 28px;
    margin-right: 6px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgb(51, 51, 51);
    color: rgb(230, 230, 230);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.compare-value-picker {
    min-width: 0;
    height: 28px;
    margin: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.compare-value-picker > .unity-base-field__input {
    min-width: 0;
}

.compare-operation-dropdown {
    width: 54px;
    min-width: 54px;
    height: 28px;
    margin-left: 6px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    flex-shrink: 0;
}

.compare-operation-dropdown.tooltip-popup-field,
.compare-operator-dropdown.tooltip-popup-field,
.compare-term-operator.tooltip-popup-field {
    padding-left: 5px;
    padding-right: 5px;
}

.compare-operation-dropdown > .unity-base-field__input {
    min-width: 50px;
    padding-left: 7px;
    padding-right: 5px;
}

.compare-operator-container {
    width: 56px;
    min-width: 56px;
    flex-shrink: 0;
    align-self: stretch;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 7px;
    margin-bottom: 0;
}

.compare-operator-dropdown {
    width: 48px;
    min-width: 48px;
    height: 28px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    flex-shrink: 0;
}

.compare-operator-dropdown > .unity-base-field__input {
    min-width: 44px;
    padding-left: 6px;
    padding-right: 4px;
}

.keyboard-key-picker {
    width: 130px;
    min-width: 130px;
    height: 27px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.check-property-field {
    width: 150px;
    min-width: 150px;
    max-width: 150px;
    flex-shrink: 0;
}

.collision-tag-dropdown {
    width: 110px;
    min-width: 110px;
    max-width: 110px;
    flex-shrink: 0;
}

.compare-terms {
    height: 34px;
    min-height: 34px;
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
    padding-right: 4px;
    background-color: rgb(51, 51, 51);
    border-left-color: rgb(66, 66, 66);
    border-right-color: rgb(66, 66, 66);
    border-top-color: rgb(66, 66, 66);
    border-bottom-color: rgb(66, 66, 66);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.compare-terms-content {
    min-width: 0;
    height: 28px;
    min-height: 28px;
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
}

.compare-empty-expression {
    color: rgb(181, 181, 181);
    font-size: 10px;
    -unity-font-style: italic;
    margin-left: 5px;
}

.compare-term {
    flex-direction: row;
    align-items: center;
    margin-right: 4px;
    margin-bottom: 0;
    max-width: 100%;
}

.compare-term-operator {
    width: 46px;
    min-width: 46px;
    height: 24px;
    margin-left: 0;
    margin-right: 4px;
    margin-top: 0;
    margin-bottom: 0;
    flex-shrink: 0;
}

.compare-term-operator > .unity-base-field__input {
    min-width: 42px;
    min-height: 24px;
    padding-left: 7px;
    padding-right: 5px;
}

.compare-pending-operator {
    min-height: 24px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    -unity-text-align: middle-center;
}

.compare-property-term {
    min-width: 92px;
    max-width: 180px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.compare-legacy-term {
    min-width: 92px;
    max-width: 180px;
}

.compare-remove-term {
    width: 24px;
    min-width: 24px;
    height: 24px;
    margin-left: 6px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    flex-shrink: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 1px;
    font-size: 14px;
    -unity-text-align: middle-center;
}

/* ═══════════════════════════════════════════
   TOGGLE
   ═══════════════════════════════════════════ */

Toggle {
    margin-top: 5px;
    margin-bottom: 5px;
    margin-left: 2px;
    margin-right: 2px;
}

Toggle > Label {
    min-width: 100px;
    padding-left: 5px;
}

/* ═══════════════════════════════════════════
   FOLDOUT
   ═══════════════════════════════════════════ */

Foldout {
    margin-top: 5px;
    margin-bottom: 5px;
}

Foldout > Toggle {
    background-color: rgb(51, 51, 51);
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    padding-right: 5px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

Foldout > Toggle:hover {
    background-color: rgb(56, 56, 56);
}

/* ═══════════════════════════════════════════
   POPUP / DROPDOWN
   ═══════════════════════════════════════════ */

PopupField {
    background-color: rgb(56, 56, 56);
    border-left-color: rgb(66, 66, 66);
    border-right-color: rgb(66, 66, 66);
    border-top-color: rgb(66, 66, 66);
    border-bottom-color: rgb(66, 66, 66);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    margin: 2px;
}

/* ═══════════════════════════════════════════
   PANEL / SECTION CONTAINERS
   ═══════════════════════════════════════════ */

.panel-container {
    background-color: rgb(37, 37, 37);
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
    flex-grow: 1;
}

.panel-section {
    background-color: rgb(51, 51, 51);
    border-left-color: rgb(66, 66, 66);
    border-right-color: rgb(66, 66, 66);
    border-top-color: rgb(66, 66, 66);
    border-bottom-color: rgb(66, 66, 66);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
    margin-top: 5px;
    margin-bottom: 5px;
}

.panel-header {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(230, 230, 230);
    margin-bottom: 10px;
}

/* ═══════════════════════════════════════════
   LIST ITEMS (legacy — used by old panels)
   ═══════════════════════════════════════════ */

.list-item {
    background-color: rgb(51, 51, 51);
    border-left-color: rgb(66, 66, 66);
    border-right-color: rgb(66, 66, 66);
    border-top-color: rgb(66, 66, 66);
    border-bottom-color: rgb(66, 66, 66);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
    margin-top: 3px;
    margin-bottom: 3px;
    flex-direction: row;
    align-items: center;
}

.list-item:hover {
    background-color: rgb(56, 56, 56);
}

.list-item-selected {
    color: rgb(161, 138, 224);
    border-left-color: rgb(161, 138, 224);
    border-right-color: rgb(161, 138, 224);
    border-top-color: rgb(161, 138, 224);
    border-bottom-color: rgb(161, 138, 224);
}

.actor-prefab-label { color: rgb(181, 181, 181); }
.actor-rule-count { color: rgb(161, 138, 224); }
.list-item-selected Label,
.list-item-selected .actor-prefab-label,
.list-item-selected .actor-rule-count { color: rgb(161, 138, 224); }

/* ═══════════════════════════════════════════
   ACTOR LIST ITEM  (Hierarchy window)
   ═══════════════════════════════════════════ */

.actor-list-item {
    background-color: transparent;
    transition-duration: 0.08s;
}

.actor-list-item:hover {
    background-color: rgb(51, 51, 51);
}

.actor-list-item--selected > Label {
    color: rgb(161, 138, 224);
}

/* 3-dot menu button */
.actor-menu-btn {
    width: 22px;
    height: 22px;
    font-size: 14px;
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    color: rgb(181, 181, 181);
    padding: 0;
    margin: 0;
    -unity-text-align: middle-center;
    opacity: 0;
    transition-duration: 0.1s;
}

.actor-list-item:hover > .actor-menu-btn {
    opacity: 1;
}

.actor-menu-btn:hover {
    background-color: rgb(56, 56, 56);
    color: rgb(230, 230, 230);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

/* ═══════════════════════════════════════════
   FAB — Create Actor Button
   ═══════════════════════════════════════════ */

.fab-create {
    width: 40px;
    height: 40px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    color: rgb(161, 138, 224);
    border-left-color: rgb(161, 138, 224);
    border-right-color: rgb(161, 138, 224);
    border-top-color: rgb(161, 138, 224);
    border-bottom-color: rgb(161, 138, 224);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    font-size: 20px;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

/* ═══════════════════════════════════════════
   HELP BOXES
   ═══════════════════════════════════════════ */

.help-box {
    background-color: rgb(51, 51, 51);
    border-left-color: rgb(161, 138, 224);
    border-right-color: rgb(161, 138, 224);
    border-top-color: rgb(161, 138, 224);
    border-bottom-color: rgb(161, 138, 224);
    border-left-width: 4px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
    margin-top: 10px;
    margin-bottom: 10px;
    margin-left: 5px;
    margin-right: 5px;
}

.help-box-warning {
    background-color: rgb(51, 51, 51);
    border-left-color: rgb(217, 182, 92);
    border-right-color: rgb(217, 182, 92);
    border-top-color: rgb(217, 182, 92);
    border-bottom-color: rgb(217, 182, 92);
    border-left-width: 4px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.help-box-error {
    background-color: rgb(51, 51, 51);
    border-left-color: rgb(222, 112, 120);
    border-right-color: rgb(222, 112, 120);
    border-top-color: rgb(222, 112, 120);
    border-bottom-color: rgb(222, 112, 120);
    border-left-width: 4px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

/* ═══════════════════════════════════════════
   TOOLBAR
   ═══════════════════════════════════════════ */

Toolbar {
    background-color: rgb(51, 51, 51);
    border-bottom-width: 1px;
    border-bottom-color: rgb(66, 66, 66);
}

ToolbarButton {
    background-color: transparent;
    color: rgb(230, 230, 230);
    border-width: 0;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
}

ToolbarButton:hover {
    background-color: rgb(51, 51, 51);
}

ToolbarButton:active {
    background-color: rgb(66, 66, 66);
}

/* ═══════════════════════════════════════════
   SEPARATORS
   ═══════════════════════════════════════════ */

.separator {
    height: 1px;
    background-color: rgb(66, 66, 66);
    margin: 10px 0;
}

.separator-vertical {
    width: 1px;
    background-color: rgb(66, 66, 66);
    margin: 0 10px;
}

/* ═══════════════════════════════════════════
   SPACING UTILITIES
   ═══════════════════════════════════════════ */

.mt-5 { margin-top: 5px; }
.mt-10 { margin-top: 10px; }
.mt-20 { margin-top: 20px; }
.mb-5 { margin-bottom: 5px; }
.mb-10 { margin-bottom: 10px; }
.mb-20 { margin-bottom: 20px; }
.ml-5 { margin-left: 5px; }
.ml-10 { margin-left: 10px; }
.mr-5 { margin-right: 5px; }
.mr-10 { margin-right: 10px; }

.p-5 {
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    padding-right: 5px;
}
.p-10 {
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
}
.p-20 {
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    padding-right: 20px;
}

/* ═══════════════════════════════════════════
   FLEX UTILITIES
   ═══════════════════════════════════════════ */

.flex-row {
    flex-direction: row;
}

.flex-column {
    flex-direction: column;
}

.flex-grow {
    flex-grow: 1;
}

.justify-center {
    justify-content: center;
}

.align-center {
    align-items: center;
}

.space-between {
    justify-content: space-between;
}

/* ═══════════════════════════════════════════
   TEXT UTILITIES
   ═══════════════════════════════════════════ */

.text-center {
    -unity-text-align: middle-center;
}

.text-bold {
    -unity-font-style: bold;
}

.text-large {
    font-size: 16px;
}

.text-small {
    font-size: 10px;
}

.text-muted {
    color: rgb(181, 181, 181);
}

/* Light Unity skin. Keep action/condition/selection colours, but use light neutral
   surfaces and dark text. The root class is updated when Unity changes skin. */
#unity-content-container.gamerule-light,
.gamerule-light #unity-content-container,
.gamerule-light,
.gamerule-light ScrollView,
.gamerule-light .panel-container {
    background-color: rgb(242, 242, 242);
}

.gamerule-light Label,
.gamerule-light .panel-header,
.gamerule-light ToolbarButton {
    color: rgb(35, 35, 35);
}

.gamerule-light .text-muted,
.gamerule-light .actor-menu-btn,
.gamerule-light Button:disabled {
    color: rgb(92, 92, 92);
}

.gamerule-light TextField,
.gamerule-light TextField > TextInput,
.gamerule-light PopupField {
    background-color: rgb(255, 255, 255);
    color: rgb(35, 35, 35);
    border-left-color: rgb(182, 182, 182);
    border-right-color: rgb(182, 182, 182);
    border-top-color: rgb(182, 182, 182);
    border-bottom-color: rgb(182, 182, 182);
}

.gamerule-light .unity-base-field__input,
.gamerule-light .unity-base-popup-field__text {
    color: rgb(35, 35, 35);
}

.gamerule-light .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(35, 35, 35);
}

.gamerule-light TextField:focus {
    border-left-color: rgb(88, 64, 150);
    border-right-color: rgb(88, 64, 150);
    border-top-color: rgb(88, 64, 150);
    border-bottom-color: rgb(88, 64, 150);
}

.gamerule-light Button,
.gamerule-light Foldout > Toggle,
.gamerule-light .list-item {
    background-color: rgb(226, 226, 226);
    color: rgb(35, 35, 35);
    border-left-color: rgb(182, 182, 182);
    border-right-color: rgb(182, 182, 182);
    border-top-color: rgb(182, 182, 182);
    border-bottom-color: rgb(182, 182, 182);
}

.gamerule-light Button:hover,
.gamerule-light Foldout > Toggle:hover,
.gamerule-light .list-item:hover,
.gamerule-light .actor-list-item:hover,
.gamerule-light ToolbarButton:hover,
.gamerule-light .actor-menu-btn:hover {
    background-color: rgb(211, 211, 211);
    color: rgb(35, 35, 35);
}

.gamerule-light Button:active,
.gamerule-light ToolbarButton:active {
    background-color: rgb(197, 197, 197);
}

.gamerule-light Button:disabled {
    background-color: rgb(234, 234, 234);
}

.gamerule-light .panel-section,
.gamerule-light .action-expression-selection,
.gamerule-light .compare-terms,
.gamerule-light .compare-operand,
.gamerule-light .compare-operand-label {
    background-color: rgb(250, 250, 250);
    color: rgb(35, 35, 35);
    border-left-color: rgb(182, 182, 182);
    border-right-color: rgb(182, 182, 182);
    border-top-color: rgb(182, 182, 182);
    border-bottom-color: rgb(182, 182, 182);
}

.gamerule-light .action-picker-value-display:hover,
.gamerule-light .action-selected-value:hover,
.gamerule-light .action-legacy-value:hover,
.gamerule-light .compare-property-term:hover {
    background-color: rgb(231, 231, 231);
    color: rgb(35, 35, 35);
}

.gamerule-light .action-empty-expression,
.gamerule-light .compare-empty-expression,
.gamerule-light .action-empty-value,
.gamerule-light .action-number-degree-suffix {
    color: rgb(35, 35, 35);
}

.gamerule-light .tooltip-dropdown-menu {
    background-color: rgb(248, 248, 248);
    border-left-color: rgb(182, 182, 182);
    border-right-color: rgb(182, 182, 182);
    border-top-color: rgb(182, 182, 182);
    border-bottom-color: rgb(182, 182, 182);
}

.gamerule-light .help-box {
    background-color: rgb(237, 231, 250);
}
.gamerule-light .help-box-warning {
    background-color: rgb(255, 246, 223);
}
.gamerule-light .help-box-error {
    background-color: rgb(251, 231, 235);
}

.gamerule-light Toolbar {
    background-color: rgb(226, 226, 226);
    border-bottom-color: rgb(182, 182, 182);
}

.gamerule-light .separator,
.gamerule-light .separator-vertical {
    background-color: rgb(182, 182, 182);
}

/* Explicit accent rules take precedence over the neutral Button/field rules above. */
.gamerule-light .fab-create,
.gamerule-light .button-primary,
.gamerule-light .button-success,
.gamerule-light .list-item.list-item-selected,
.gamerule-light .actor-list-item.actor-list-item--selected {
    background-color: rgb(238, 238, 238);
    color: rgb(88, 64, 150);
}
.gamerule-light .fab-create:hover,
.gamerule-light .button-primary:hover,
.gamerule-light .button-success:hover,
.gamerule-light .list-item.list-item-selected:hover,
.gamerule-light .actor-list-item.actor-list-item--selected:hover {
    background-color: rgb(226, 226, 226);
    color: rgb(88, 64, 150);
}
.gamerule-light .button-secondary {
    background-color: rgb(238, 238, 238);
    color: rgb(88, 64, 150);
}
.gamerule-light .button-secondary:hover {
    background-color: rgb(226, 226, 226);
    color: rgb(88, 64, 150);
}
.gamerule-light .button-negation.button-negation--active {
    background-color: rgb(204, 0, 31);
    color: rgb(255, 255, 255);
}
.gamerule-light .button-negation.button-negation--active:hover {
    background-color: rgb(226, 26, 54);
    color: rgb(255, 255, 255);
}
.gamerule-light .button-condition,
.gamerule-light .button-condition > .unity-base-field__input {
    background-color: rgb(238, 238, 238);
    color: rgb(15, 103, 120);
}
.gamerule-light .button-condition:hover,
.gamerule-light .button-condition:hover > .unity-base-field__input {
    background-color: rgb(226, 226, 226);
}
.gamerule-light .button-condition:active,
.gamerule-light .button-condition:active > .unity-base-field__input {
    background-color: rgb(213, 213, 213);
}
.gamerule-light .button-action,
.gamerule-light .button-action > .unity-base-field__input {
    background-color: rgb(238, 238, 238);
    color: rgb(145, 68, 23);
}
.gamerule-light .button-action:hover,
.gamerule-light .button-action:hover > .unity-base-field__input {
    background-color: rgb(226, 226, 226);
}
.gamerule-light .button-action:active,
.gamerule-light .button-action:active > .unity-base-field__input {
    background-color: rgb(213, 213, 213);
}
.gamerule-light .button-property-picker,
.gamerule-light .button-property-picker > .unity-base-field__input {
    background-color: rgb(238, 238, 238);
}
.gamerule-light .button-property-picker:hover,
.gamerule-light .button-property-picker:hover > .unity-base-field__input {
    background-color: rgb(226, 226, 226);
}
.gamerule-light .button-property-picker:active,
.gamerule-light .button-property-picker:active > .unity-base-field__input {
    background-color: rgb(213, 213, 213);
}
.gamerule-light .button-number-picker,
.gamerule-light .button-number-picker > .unity-base-field__input {
    background-color: rgb(238, 238, 238);
}
.gamerule-light .button-number-picker:hover,
.gamerule-light .button-number-picker:hover > .unity-base-field__input {
    background-color: rgb(226, 226, 226);
}
.gamerule-light .button-number-picker:active,
.gamerule-light .button-number-picker:active > .unity-base-field__input {
    background-color: rgb(213, 213, 213);
}
.gamerule-light .button-condition .unity-base-popup-field__text,
.gamerule-light .button-action .unity-base-popup-field__text {
    color: rgb(15, 103, 120);
}
.gamerule-light .button-condition .unity-base-popup-field__arrow,
.gamerule-light .button-action .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(15, 103, 120);
}
.gamerule-light .button-primary .unity-base-popup-field__text {
    color: rgb(88, 64, 150);
}
.gamerule-light .button-primary > .unity-base-field__input {
    color: rgb(88, 64, 150);
}
.gamerule-light .button-primary .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(88, 64, 150);
}

.gamerule-light .actor-list-item--selected > Label,
.gamerule-light .list-item-selected {
    color: rgb(88, 64, 150);
}
.gamerule-light .actor-prefab-label { color: rgb(92, 92, 92); }
.gamerule-light .actor-rule-count { color: rgb(88, 64, 150); }
.gamerule-light .list-item-selected Label,
.gamerule-light .list-item-selected .actor-prefab-label,
.gamerule-light .list-item-selected .actor-rule-count { color: rgb(88, 64, 150); }

.gamerule-light .button-negation.button-negation--active:active {
    background-color: rgb(168, 0, 25);
    color: rgb(255, 255, 255);
}

.gamerule-light .button-secondary:active,
.gamerule-light .fab-create:active,
.gamerule-light .button-primary:active {
    background-color: rgb(213, 213, 213);
    color: rgb(88, 64, 150);
}

/* Shared sections and cards for Rules and Rule Details. */
.rule-overview {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    min-width: 0;
    margin-left: -4px;
    margin-right: -4px;
}

.rule-overview-responsive-column {
    flex-grow: 1;
    flex-basis: 340px;
    min-width: 0;
    max-width: 100%;
    margin-left: 4px;
    margin-right: 4px;
    margin-bottom: 8px;
}

.rule-overview-column,
.rule-editor-card {
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.rule-overview-column {
    background-color: rgb(41, 41, 41);
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 8px;
    padding-right: 8px;
}

.rule-block-heading {
    color: rgb(230, 230, 230);
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.rule-editor-card {
    background-color: rgb(51, 51, 51);
}

.rule-summary-row.rule-editor-card {
    margin-bottom: 5px;
    padding-left: 4px;
    padding-right: 4px;
}

.rule-summary-row.rule-editor-card.condition-negated {
    border-left-width: 3px;
    border-left-color: rgb(204, 0, 31);
    padding-left: 1px;
}

.rule-summary-card.button-condition,
.rule-summary-card.button-action {
    background-color: transparent;
    border-left-color: transparent;
    border-right-color: transparent;
    border-top-color: transparent;
    border-bottom-color: transparent;
}

.rule-summary-card {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 32px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.rule-summary-name,
.rule-detail-type {
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-left: 6px;
    padding-right: 6px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.rule-summary-name {
    width: 88px;
    flex-shrink: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-right: 5px;
}

.rule-detail-card {
    padding-top: 6px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    min-width: 0;
}

.rule-detail-type {
    align-self: flex-start;
    max-width: 100%;
    margin-bottom: 7px;
}

.button-condition .rule-summary-name,
.rule-detail-type.button-condition {
    color: rgb(56, 185, 207);
    background-color: rgb(37, 62, 72);
}

.button-action .rule-summary-name,
.rule-detail-type.button-action {
    color: rgb(240, 153, 89);
    background-color: rgb(67, 53, 48);
}

.rule-summary-detail {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    -unity-text-align: middle-left;
    color: rgb(230, 230, 230);
}

.rule-summary-card:hover,
.rule-detail-type:hover,
.rule-join-selector:hover,
.rule-add-element:hover {
    background-color: rgb(56, 56, 56);
}

.rule-summary-card.rule-summary-selected,
.rule-summary-card:focus,
.rule-detail-type:focus,
.rule-join-selector:focus,
.rule-add-element:focus {
    border-left-color: rgb(161, 138, 224);
    border-right-color: rgb(161, 138, 224);
    border-top-color: rgb(161, 138, 224);
    border-bottom-color: rgb(161, 138, 224);
}

.rule-join-selector,
.rule-add-element {
    align-self: center;
}

.rule-join-selector {
    min-height: 22px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 7px;
    padding-right: 7px;
    margin-top: 3px;
    margin-bottom: 3px;
    font-size: 10px;
}

.rule-add-element {
    margin-top: 7px;
    max-width: 100%;
}

.gamerule-light .rule-overview-column { background-color: rgb(226, 226, 226); }
.gamerule-light .rule-editor-card { background-color: rgb(250, 250, 250); }
.gamerule-light .rule-block-heading { color: rgb(35, 35, 35); }
.gamerule-light .button-condition .rule-summary-name,
.gamerule-light .rule-detail-type.button-condition {
    background-color: rgb(226, 241, 244);
    color: rgb(15, 103, 120);
}
.gamerule-light .button-action .rule-summary-name,
.gamerule-light .rule-detail-type.button-action {
    background-color: rgb(250, 237, 225);
    color: rgb(145, 68, 23);
}
.gamerule-light .rule-summary-detail {
    color: rgb(35, 35, 35);
}

.button-condition .unity-base-popup-field__arrow { -unity-background-image-tint-color: rgb(56, 185, 207); }
.button-action .unity-base-popup-field__arrow { -unity-background-image-tint-color: rgb(240, 153, 89); }
.button-primary .unity-base-popup-field__arrow { -unity-background-image-tint-color: rgb(161, 138, 224); }
.gamerule-light .button-property-picker .unity-base-popup-field__text { color: rgb(121, 88, 18); }
.gamerule-light .button-property-picker .unity-base-popup-field__arrow { -unity-background-image-tint-color: rgb(121, 88, 18); }
.gamerule-light .button-number-picker .unity-base-popup-field__text { color: rgb(29, 109, 81); }
.gamerule-light .button-number-picker .unity-base-popup-field__arrow { -unity-background-image-tint-color: rgb(29, 109, 81); }

/* Native field inputs, in windows that load this stylesheet. */
.unity-integer-field > .unity-base-field__input,
.unity-float-field > .unity-base-field__input,
.unity-object-field > .unity-base-field__input,
PopupField > .unity-base-field__input,
.unity-dropdown-field > .unity-base-field__input {
    background-color: rgb(56, 56, 56);
    color: rgb(230, 230, 230);
    border-left-color: rgb(66, 66, 66);
    border-right-color: rgb(66, 66, 66);
    border-top-color: rgb(66, 66, 66);
    border-bottom-color: rgb(66, 66, 66);
}

.gamerule-light .unity-integer-field > .unity-base-field__input,
.gamerule-light .unity-float-field > .unity-base-field__input,
.gamerule-light .unity-object-field > .unity-base-field__input,
.gamerule-light PopupField > .unity-base-field__input,
.gamerule-light .unity-dropdown-field > .unity-base-field__input {
    background-color: rgb(255, 255, 255);
    color: rgb(35, 35, 35);
    border-left-color: rgb(182, 182, 182);
    border-right-color: rgb(182, 182, 182);
    border-top-color: rgb(182, 182, 182);
    border-bottom-color: rgb(182, 182, 182);
}


/* Shared treatment for editable inputs, parameter selectors and displayed values. */
.numeric-stepper-field > .unity-base-field__input,
.action-picker-value-display,
.action-selected-value,
.action-legacy-value,
.compare-property-term,
.compare-legacy-term,
.parameter-selector,
.parameter-selector > .unity-base-field__input {
    min-height: 28px;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: rgb(56, 56, 56);
    border-left-color: rgb(66, 66, 66);
    border-right-color: rgb(66, 66, 66);
    border-top-color: rgb(66, 66, 66);
    border-bottom-color: rgb(66, 66, 66);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.numeric-stepper-field > .unity-base-field__input {
    color: rgb(230, 230, 230);
}

.action-picker-value-display,
.action-selected-value,
.action-legacy-value,
.compare-property-term,
.compare-legacy-term {
    color: rgb(230, 230, 230);
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 1;
}

.action-legacy-value,
.compare-legacy-term,
.action-picker-value-display.action-empty-value {
    color: rgb(181, 181, 181);
    -unity-font-style: italic;
}

.action-picker-value-display:hover,
.action-selected-value:hover,
.action-legacy-value:hover,
.compare-property-term:hover,
.numeric-stepper-field > .unity-base-field__input:hover,
.parameter-selector:hover,
.parameter-selector:hover > .unity-base-field__input {
    background-color: rgb(51, 51, 51);
}

.parameter-selector:active,
.parameter-selector:active > .unity-base-field__input {
    background-color: rgb(37, 37, 37);
}

.numeric-stepper-field:focus > .unity-base-field__input,
.numeric-stepper-field > .unity-base-field__input:focus,
.unity-integer-field > .unity-base-field__input:focus,
.unity-float-field > .unity-base-field__input:focus,
.unity-object-field:focus > .unity-base-field__input,
.unity-dropdown-field:focus > .unity-base-field__input,
.action-picker-value-display:focus,
.action-selected-value:focus,
.action-legacy-value:focus,
.compare-property-term:focus,
.parameter-selector:focus,
.parameter-selector:focus > .unity-base-field__input {
    border-left-color: rgb(161, 138, 224);
    border-right-color: rgb(161, 138, 224);
    border-top-color: rgb(161, 138, 224);
    border-bottom-color: rgb(161, 138, 224);
}

.action-picker-value-display:disabled,
.action-selected-value:disabled,
.action-legacy-value:disabled,
.compare-property-term:disabled,
.numeric-stepper-field:disabled > .unity-base-field__input,
.parameter-selector:disabled,
.parameter-selector:disabled > .unity-base-field__input,
.parameter-selector:disabled .unity-base-popup-field__text {
    background-color: rgb(51, 51, 51);
    color: rgb(181, 181, 181);
}

.parameter-selector:disabled .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(181, 181, 181);
}

/* Native arithmetic dropdowns draw the frame on the inner input only. */
PopupField.parameter-selector {
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.action-term-operator.parameter-selector > .unity-base-field__input {
    min-width: 0;
    padding-left: 4px;
    padding-right: 4px;
}

.action-operation-picker.parameter-selector > .unity-base-field__input {
    padding-left: 6px;
    padding-right: 6px;
}

.compare-operation-dropdown.parameter-selector,
.compare-operator-dropdown.parameter-selector,
.compare-term-operator.parameter-selector {
    padding-left: 4px;
    padding-right: 4px;
}

.compare-compact-picker-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.compare-compact-picker-row .compare-value-picker {
    flex-basis: 172px;
    max-width: 100%;
}

.compare-compact-picker-row .compare-operation-dropdown {
    margin-left: 0;
}

.compare-compact-picker-row .parameter-selector {
    margin-right: 4px;
    margin-bottom: 3px;
}

.gamerule-light .numeric-stepper-field > .unity-base-field__input,
.gamerule-light .action-picker-value-display,
.gamerule-light .action-selected-value,
.gamerule-light .action-legacy-value,
.gamerule-light .compare-property-term,
.gamerule-light .compare-legacy-term,
.gamerule-light .parameter-selector,
.gamerule-light .parameter-selector > .unity-base-field__input {
    background-color: rgb(250, 250, 250);
    border-left-color: rgb(182, 182, 182);
    border-right-color: rgb(182, 182, 182);
    border-top-color: rgb(182, 182, 182);
    border-bottom-color: rgb(182, 182, 182);
}

.gamerule-light .numeric-stepper-field > .unity-base-field__input,
.gamerule-light .action-picker-value-display,
.gamerule-light .action-selected-value,
.gamerule-light .compare-property-term {
    color: rgb(35, 35, 35);
}

.gamerule-light .action-legacy-value,
.gamerule-light .compare-legacy-term,
.gamerule-light .action-picker-value-display.action-empty-value {
    color: rgb(92, 92, 92);
}

.gamerule-light PopupField.parameter-selector {
    background-color: transparent;
}

.gamerule-light .parameter-selector:hover,
.gamerule-light .parameter-selector:hover > .unity-base-field__input,
.gamerule-light .action-picker-value-display:hover,
.gamerule-light .action-selected-value:hover,
.gamerule-light .action-legacy-value:hover,
.gamerule-light .compare-property-term:hover,
.gamerule-light .numeric-stepper-field > .unity-base-field__input:hover {
    background-color: rgb(231, 231, 231);
}

.gamerule-light .parameter-selector:active,
.gamerule-light .parameter-selector:active > .unity-base-field__input {
    background-color: rgb(226, 226, 226);
}

.gamerule-light .action-picker-value-display:disabled,
.gamerule-light .action-selected-value:disabled,
.gamerule-light .action-legacy-value:disabled,
.gamerule-light .compare-property-term:disabled,
.gamerule-light .numeric-stepper-field:disabled > .unity-base-field__input,
.gamerule-light .parameter-selector:disabled,
.gamerule-light .parameter-selector:disabled > .unity-base-field__input,
.gamerule-light .parameter-selector:disabled .unity-base-popup-field__text {
    background-color: rgb(234, 234, 234);
    color: rgb(92, 92, 92);
}

.gamerule-light .parameter-selector:disabled .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(92, 92, 92);
}

.gamerule-light .numeric-stepper-field:focus > .unity-base-field__input,
.gamerule-light .numeric-stepper-field > .unity-base-field__input:focus,
.gamerule-light .unity-integer-field > .unity-base-field__input:focus,
.gamerule-light .unity-float-field > .unity-base-field__input:focus,
.gamerule-light .unity-object-field:focus > .unity-base-field__input,
.gamerule-light .unity-dropdown-field:focus > .unity-base-field__input,
.gamerule-light .action-picker-value-display:focus,
.gamerule-light .action-selected-value:focus,
.gamerule-light .action-legacy-value:focus,
.gamerule-light .compare-property-term:focus,
.gamerule-light .parameter-selector:focus,
.gamerule-light .parameter-selector:focus > .unity-base-field__input {
    border-left-color: rgb(88, 64, 150);
    border-right-color: rgb(88, 64, 150);
    border-top-color: rgb(88, 64, 150);
    border-bottom-color: rgb(88, 64, 150);
}

/* The actor name draws its frame only on the editable input. */
TextField.actor-properties-name,
.gamerule-light TextField.actor-properties-name {
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.actor-properties-name > .unity-base-field__input:focus,
.gamerule-light .actor-properties-name > .unity-base-field__input:focus {
    border-left-color: rgb(161, 138, 224);
    border-right-color: rgb(161, 138, 224);
    border-top-color: rgb(161, 138, 224);
    border-bottom-color: rgb(161, 138, 224);
}


