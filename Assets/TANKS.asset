      - 0
      - 90
      - 0
      Density: 0
      Friction: 0.6
      Bounciness: 0
      Drag: 0.2
      Properties:
      - speed=10
      - angularSpeed=90
      - health=100
      - offsetY=1.7
      - offsetZ=1.35
      - maxAim=200
      - currentAim=0
      Script:
      - Name: Rule 1
        When:
        - Keyboard(D,press)
        Do:
        - Rotate(this.angularSpeed,this.rx,this.ry,this.rz)
        - PlayParticles(DustTrail)
        groupId: gf73479cb
      - Name: Rule 2
        When:
        - Keyboard(A,press)
        Do:
        - Rotate(-this.angularSpeed,this.rx,this.ry,this.rz)
        - PlayParticles(DustTrail)
        groupId: gf73479cb
      - Name: Rule 3
        When:
        - Keyboard(W,press)
        Do:
        - Move(this.speed,0,this.ry,0)
        groupId: gf73479cb
      - Name: Rule 4
        When:
        - Keyboard(S,press)
        Do:
        - Move(this.speed,0,this.ry+180,0)
        groupId: gf73479cb
      - Name: Rule 5
        When:
        - Collision(Shell)
        Do:
        - Edit(this.health,this.health-Shell.damage)
        - PushTo(-300,RedTank.x,RedTank.y,RedTank.z)
        groupId: gf73479cb
      - Name: Rule 6
        When:
        - Compare(this.health<=0)
        Do:
        - Edit(RedWin.Active,1)
        groupId: gf73479cb
      - Name: Rule 7
        When:
        - Keyboard(Space,press)
        Do:
        - Edit(this.currentAim,this.currentAim+1)
        - PlaySound(ShotCharging)
        groupId: gf73479cb
      - Name: Rule 8
        When:
        - Compare(this.currentAim>=this.maxAim)
        Do:
        - Edit(this.currentAim,this.maxAim)
        groupId: gf73479cb
      - Name: Rule 9
        When:
        - Keyboard(Space,up)
        Do:
        - Spawn(Shell,this,0,this.offsetY,this.offsetZ)
        - Edit(this.currentAim,0)
        - PlaySound(ShotFiring)
        groupId: gf73479cb
      Components:
      - type: Properties
        name: Properties
        id: 
      - type: Rules
        name: Rules
        id: gf73479cb
