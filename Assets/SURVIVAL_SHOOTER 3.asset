      - Compare(Player.health<0)
      Do:
      - Edit(this.moving,0)
      - Edit(this.speed,0)
    - Name: 
      When:
      - Collision(Bullet)
      Do:
      - Edit(this.health,this.health-Bullet.damage)
      - PlaySound(ZomBunnyHurt)
      - PlayParticles(HitParticles)
    - Name: 
      When:
      - Compare(this.health<=0)
      Do:
      - Edit(#Score,#Score+10)
      - Spawn(ZomBunnyDead,this)
      - Delete(this)
    - Name: 
      When:
      - NOT Check(this.moving)
      Do:
      - Animate(Idle)
    - Name: 
      When:
      - Check(this.moving)
      Do:
      - Animate(Move)
  - ActorName: Player
    Active: 1
    PrefabName: Player
    Tag: Player
    IconColorHex: '#FFFFFF'
    Position:
    - 0
    - 0
    - 0
    Rotation:
    - -0
    - 0
    - 0
    Scale:
    - 1
    - 1
    - 1
    Size: []
    Velocity: []
    AngularVelocity: []
    Density: 0
    Friction: 0
    Bounciness: 0
    Drag: 0
    Properties:
    - lastHealth=100.0
    - rotSpeed=360
    - speed=5
    - offsetCam=7
    - health=100.0
    - offsetX=0.28
    - offsetY=0.3
    - offsetZ=0.7
    - moving=0
    Script:
    - Name: Moving?
      When:
      - NOT Check(this.moving) AND Compare(this.health > 0) AND Compare( < )
      Do:
      - Animate(Idle)
    - Name: Rule 2
      When:
      - Compare(this.health==this.lastHealth)
      Do:
      - Edit(DamageCanvas.Active,0)
    - Name: c
      When:
      - Keyboard(RightArrow,press)
      Do:
      - Move(this.speed, 0, 90, 0)
      - Edit(this.moving,1)
    - Name: Rule 4
      When:
      - Keyboard(DownArrow,press)
      Do:
      - Move(this.speed, 0, 180, 0)
      - Edit(this.moving,1)
    - Name: Rule 5
      When:
      - Collision(Hellephant)
      Do:
      - Edit(this.health,this.health-Hellephant.damage)
      - PlaySound(PlayerHurt)
    - Name: Rule 6
      When:
      - Collision(ZomBear)
      Do:
      - Edit(this.health,this.health-ZomBear.damage)
      - PlaySound(PlayerHurt)
    - Name: Rule 7
      When:
      - Keyboard(RightArrow,up) OR Keyboard(LeftArrow,up) OR Keyboard(UpArrow,up)
        OR Keyboard(DownArrow,up)
      Do:
      - Edit(this.moving,0)
    - Name: Rule 8
      When:
      - Collision(ZomBunny)
      Do:
      - Edit(this.health,this.health-ZomBunny.damage)
      - PlaySound(PlayerHurt)
    - Name: Rule 9
      When:
      - Keyboard(UpArrow,press)
      Do:
      - Move(this.speed, 0, 0, 0)
      - Edit(this.moving,1)
    - Name: Rule 10
      When:
      - Check(this.moving)
      Do:
      - Animate(Move)
    - Name: Rule 11
      When:
      - Compare(this.health<=0)
      Do:
      - Edit(GameOver.Active,1)
      - PlaySound(PlayerDeath)
      - Edit(this.moving,0)
      - Edit(this.speed,0)
    - Name: Rule 12
      When: []
      Do:
      - RotateTo(this.rotSpeed,#MouseWorld.x,#MouseWorld.y,#MouseWorld.z,this.x,this.y,this.z)
      - Edit(#CameraPosition.x,this.x)
      - Edit(#CameraPosition.z,this.z-this.offsetCam)
    - Name: Rule 13
      When:
      - NOT Check(this.moving) AND Compare(this.health<=0)
      Do:
      - Animate(Death)
    - Name: Rule 14
      When:
      - Compare(this.health<this.lastHealth)
      Do:
      - Edit(DamageCanvas.Active,1)
      - Edit(this.lastHealth,this.health)
    - Name: Rule 15
      When:
      - Touch(press,false)
      Do:
      - Spawn(Bullet,this,this.offsetX,this.offsetY,this.offsetZ)
      - Spawn(Laser,this,this.offsetX,this.offsetY,this.offsetZ)
      - Edit(ShotLight.Active,1)
      - PlaySound(PlayerGunShot)
      - PlayParticles(GunBarrelEnd)
    - Name: Rule 16
      When:
      - Keyboard(LeftArrow,press)
      Do:
      - Move(this.speed, 0, -90, 0)
      - Edit(this.moving,1)
    - Name: Rule 17
      When:
      - 
      Do:
      - 
    - Name: Rule 18
      When:
      - NOT Compare( < ) OR Compare( < ) AND Compare( < )
      Do: []
