      Bounciness: 0
      Drag: 0
      Properties:
      - speed=1
      - offset=5.6
      - moving=0
      Script:
      - Name: 
        When: []
        Do:
        - Edit(#CameraPosition.x,this.x)
        - Edit(#CameraPosition.z,this.z-this.offset)
        groupId: 
      - Name: 
        When:
        - Keyboard(RightArrow,press)
        Do:
        - Move(this.speed,0,90,0)
        - Edit(this.ry,90)
        - Edit(this.moving,1)
        groupId: 
      - Name: 
        When:
        - Keyboard(LeftArrow,press)
        Do:
        - Move(this.speed,0,-90,0)
        - Edit(this.ry,-90)
        - Edit(this.moving,1)
        groupId: 
      - Name: 
        When:
        - Keyboard(UpArrow,press)
        Do:
        - Move(this.speed,0,0,0)
        - Edit(this.ry,0)
        - Edit(this.moving,1)
        groupId: 
      - Name: 
        When:
        - Keyboard(DownArrow,press)
        Do:
        - Move(this.speed,0,180,0)
        - Edit(this.ry,180)
        - Edit(this.moving,1)
        groupId: 
      - Name: 
        When:
        - Keyboard(RightArrow,up) OR Keyboard(LeftArrow,up) OR Keyboard(UpArrow,up)
          OR Keyboard(DownArrow,up)
        Do:
        - Edit(this.moving,0)
        groupId: 
      - Name: 
        When:
        - Collision(Enemy)
        Do:
        - Edit(Caught.Active,1)
        groupId: 
      - Name: 
        When:
        - Collision(End)
        Do:
        - Edit(Won.Active,1)
        groupId: 
      - Name: 
        When:
        - NOT Check(this.moving)
        Do:
        - Animate(John_Idle)
        groupId: 
      - Name: 
        When:
        - Check(this.moving)
        Do:
        - Animate(John_Walk)
        - PlaySound(Footsteps)
        groupId: 
