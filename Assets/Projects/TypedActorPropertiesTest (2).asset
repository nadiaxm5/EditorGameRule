  m_Script: {fileID: 11500000, guid: 8d7ce709b4183fc45a69f027e5cd242a, type: 3}
  m_Name: TypedActorPropertiesTest (2)
  m_EditorClassIdentifier: Assembly-CSharp-Editor::GameRuleEditor.Core.GameRuleProject
  projectName: TypedActorPropertiesTest
  jsonFileName: TypedActorPropertiesTest.json
  sceneData:
    GameName: TypedActorPropertiesTest
    ScreenResolution:
    - 1920
    - 1080
    CameraPosition:
    - 0
    - 14
    - -13
    CameraRotation:
    - 50
    - 0
    - 0
