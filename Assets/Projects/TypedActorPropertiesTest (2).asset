      - name: SpawnReady
        type: bool
        intValue: 0
        floatValue: 0
        boolValue: 1
        arrayValue: []
      - name: SpawnAmmo
        type: int
        intValue: 4
        floatValue: 0
        boolValue: 0
        arrayValue: []
      - name: SpawnBoost
        type: float
        intValue: 0
        floatValue: 0.75
        boolValue: 0
        arrayValue: []
      - name: SpawnOffset
        type: vector2
        intValue: 0
        floatValue: 0
        boolValue: 0
