    - 0
    - 0
    - 0
    SoundTrack: 
    Mouse: []
    MouseWorld: []
    Cast:
    - ActorName: BlueTank
      Active: 1
      PrefabName: BlueTank
      Tag: Untagged
      IconColorHex: 
      Position:
      - -4
      - 0
      - -2
      Rotation:
      - 0
      - 0
      - 0
      Scale:
      - 1
      - 1
      - 1
      Velocity: []
      AngularVelocity: []
      Density: 0
      Friction: 0
      Bounciness: 0
      Drag: 0
      OverrideDensity: 0
      OverrideFriction: 0
      OverrideBounciness: 0
      OverrideDrag: 0
      Properties: []
      CustomProperties:
      - name: Ammo
        type: int
        intValue: 1
        floatValue: 0
        boolValue: 0
        arrayValue: []
      - name: Boost
        type: float
        intValue: 0
        floatValue: 0.5
        boolValue: 0
        arrayValue: []
      - name: Armed
        type: bool
        intValue: 0
        floatValue: 0
        boolValue: 0
        arrayValue: []
      - name: Offset
        type: vector2
        intValue: 0
        floatValue: 0
        boolValue: 0
        arrayValue:
        - 7
        - 1
      - name: Goal
        type: vector3
        intValue: 0
        floatValue: 0
        boolValue: 0
        arrayValue:
        - 0
        - 0
        - 1
      - name: LegacyStep
        type: float
        intValue: 0
        floatValue: 2
        boolValue: 0
        arrayValue: []
      Script:
      - Name: 1. Space writes typed values
        When:
        - Keyboard(Space,down) AND NOT Check(this.Armed) AND Compare(this.LegacyStep
          == 2) AND Compare(this.Boost == 0.5)
        Do:
        - Edit(this.Ammo,2.6)
        - Edit(this.Boost,this.Boost+1)
        - Edit(this.Offset.x,this.Offset.x+1)
        - Edit(this.Goal.z,this.Goal.z+this.LegacyStep)
        - Edit(this.Armed,1)
        - Edit(#TypedTestPassed,1)
        groupId: typed-blue
      - Name: 2. Verify changes and spawn the red tank
        When:
        - Check(this.Armed) AND Check(#TypedTestPassed) AND Compare(this.Ammo ==
          3) AND Compare(this.Boost == 1.5) AND Compare(this.Offset.x == 8) AND Compare(this.Goal.z
          == 3)
        Do:
        - Spawn(RedTank,this,this.Offset.x,0,0,0,0,0)
        - Edit(this.z,this.Goal.z)
        - Edit(#TypedTestPassed,0)
        groupId: typed-blue
      Components:
      - type: Properties
        name: Custom Properties
        id: 
      - type: Rules
        name: Rules
        id: typed-blue
