      - name: SpawnGoal
        type: vector3
        intValue: 0
        floatValue: 0
        boolValue: 0
        arrayValue:
        - 0
        - 0
        - 2.5
      Script:
      - Name: 3. Verify spawned defaults and move to Z 4
        When:
        - Check(this.SpawnReady) AND Compare(this.SpawnAmmo == 4) AND Compare(this.SpawnBoost
          == 0.75) AND Compare(this.SpawnOffset.y == 1.5) AND Compare(this.SpawnGoal.z
          == 2.5)
        Do:
        - Edit(this.z,this.SpawnGoal.z+this.SpawnOffset.y)
        - Edit(this.SpawnReady,0)
        groupId: typed-red
      Components:
      - type: Properties
        name: Custom Properties
        id: 
      - type: Rules
        name: Rules
        id: typed-red
