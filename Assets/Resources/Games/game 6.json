        },{
            "ActorName":"GameOver",
            "PrefabName":"GameOver",
            "Active": false,
            "Properties":["counter=0"],
            "Script":[
                {
                "When":["Compare(this.counter<100)"],
                "Do":["Animate(Idle)"]
                },
                {
                "When":["Compare(this.counter==100)"],
                "Do":["Animate(GameOver)"]
                },
                {
                "When":["Compare(this.counter==150)"],
                "Do":["LoadScene()"]
                },{
                "When":["Compare(this.counter<=150)"],
