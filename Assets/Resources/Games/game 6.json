                },
                {
                    "When": ["Collision(Bullet)"],
                    "Do": ["Edit(this.health,this.health-Bullet.damage)", "PlaySound(HellephantHurt)", "PlayParticles(HitParticles)"]
                },
                {
                    "When": ["Compare(this.health<=0)"],
                    "Do": ["Edit(Player.score,Player.score+50)", "Spawn(HellephantDead, this)", "Delete(this)"]
                },
                {
                    "When": ["Compare(this.moving==0)"],
                    "Do": ["Animate(Idle)"]
                },
                {
                    "When": ["Compare(this.moving==1)"],
                    "Do": ["Animate(Move)"]
                }
            ]
        },
