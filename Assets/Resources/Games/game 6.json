{
    "GameName": "SURVIVAL_SHOOTER",
    "CameraPosition": [0, 6, -7],
    "CameraRotation": [30, 0.0, 0.0],
    "SunPosition": [3.3899, 10.902, -5.8255],
    "SunRotation": [22.704, 65.875, -175.012],
    "SunColor": [195, 184, 255],
    "SunAmbientColor": [170, 180, 200],
    "CustomVariables": [
        {"name": "WaveNumber", "type": "int", "intValue": 1},
        {"name": "TotalEnemies", "type": "int", "intValue": 10},
        {"name": "GameDifficulty", "type": "string", "stringValue": "Hard"},
        {"name": "PlayerLives", "type": "int", "intValue": 3},
        {"name": "BonusActive", "type": "bool", "boolValue": true},
        {"name": "RespawnPosition", "type": "Vector3", "arrayValue": [5, 0, 5]},
        {"name": "GameSpeed", "type": "float", "floatValue": 1.5}
    ],
    "Cast": [
        {
            "ActorName": "LightingReflection",
            "PrefabName": "LightingReflection"
        },
        {
            "ActorName": "Environment",
            "PrefabName": "Environment",
            "Tag":"Obstacle"
        },
        {
            "ActorName": "Player",
            "PrefabName": "Player",
            "Tag":"Player",
            "Position": [0.0, 0.0, 0.0],
            "Properties": ["speed=5", "rotSpeed=360", "lastHealth=100.0", "health=100.0", "score=0", "desp=7", "despX=0.28", "despY=0.3", "despZ=0.7", "moving=0"],
            "Script": [
                {
                    "Do": ["RotateTo(this.rotSpeed, #MouseWorld.x, #MouseWorld.y, #MouseWorld.z, this.x, this.y, this.z)", "Edit(#CameraPosition.x,this.x)", "Edit(#CameraPosition.z,this.z-this.desp)"]
                },
                {
                    "When": ["Keyboard(RightArrow,press)"],
                    "Do": ["Move(this.speed, 0, 90, 0)", "Edit(this.moving,1)"]
                },
                {
                    "When": ["Keyboard(LeftArrow,press)"],
                    "Do": ["Move(this.speed, 0, -90, 0)", "Edit(this.moving,1)"]
                },
                {
                    "When": ["Keyboard(UpArrow,press)"],
                    "Do": ["Move(this.speed, 0, 0, 0)", "Edit(this.moving,1)"]
                },
                {
                    "When": ["Keyboard(DownArrow,press)"],
                    "Do": ["Move(this.speed, 0, 180, 0)", "Edit(this.moving,1)"]
                },
                { "When": ["Keyboard(RightArrow,up)"], "Do": ["Edit(this.moving,0)"] },
                { "When": ["Keyboard(LeftArrow,up)"], "Do": ["Edit(this.moving,0)"] },
                { "When": ["Keyboard(UpArrow,up)"], "Do": ["Edit(this.moving,0)"] },
                { "When": ["Keyboard(DownArrow,up)"], "Do": ["Edit(this.moving,0)"] },
                {
                    "When": ["Collision(Hellephant)"],
                    "Do": ["Edit(this.health,this.health-Hellephant.damage)", "PlaySound(PlayerHurt)"]
                },
                {
                    "When": ["Collision(ZomBear)"],
                    "Do": ["Edit(this.health,this.health-ZomBear.damage)", "PlaySound(PlayerHurt)"]
                },
                {
                    "When": ["Collision(ZomBunny)"],
                    "Do": ["Edit(this.health,this.health-ZomBunny.damage)", "PlaySound(PlayerHurt)"]
                },
                {
                    "When":["Compare(this.health<0)"],
                    "Do":["Edit(GameOver.Active,1)", "PlaySound(PlayerDeath)", "Edit(this.moving,2)", "Edit(this.speed,0)"]
                },
                {
                    "When":["Compare(this.health==this.lastHealth)"],
                    "Do":["Edit(DamageCanvas.Active,0)"]
                },
                {
                    "When":["Compare(this.health<this.lastHealth)"],
                    "Do":["Edit(DamageCanvas.Active,1)", "Edit(this.lastHealth,this.health)"]
                },
                {
                    "When": ["Touch(press)"],
                    "Do": ["Spawn(Bullet, this, this.despX, this.despY, this.despZ)", "Spawn(Laser, this, this.despX, this.despY, this.despZ)", "Edit(ShotLight.Active,1)", "PlaySound(PlayerGunShot)", "PlayParticles(GunBarrelEnd)"]
                },
                {
                    "When": ["Compare(this.moving==0)"],
                    "Do": ["Animate(Idle)"]
                },
                {
                    "When": ["Compare(this.moving==1)"],
                    "Do": ["Animate(Move)"]
                },
                {
                    "When": ["Compare(this.moving==2)"],
                    "Do": ["Animate(Death)"]
                }
            ]
        },
        {
            "ActorName": "Hellephant",
            "PrefabName": "Hellephant",
            "Tag":"Hellephant",
            "Active": false,
            "Position": [0.0, 0.0, 32.0],
            "Rotation": [0.0, -130.0, 0.0],
            "Properties": ["speed=2", "health=300", "damage=0.3", "moving=0"],
            "Script": [
                {
                    "Do": ["Edit(this.moving,1)", "NavigateTo(this.speed,Player.x,Player.y,Player.z)"]
                },
                {
                    "When":["Compare(Player.health<0)"],
