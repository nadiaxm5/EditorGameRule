{
    "GameName": "TypedActorPropertiesTest",
    "ScreenResolution": [1920, 1080],
    "CameraPosition": [0, 14, -13],
    "CameraRotation": [50, 0, 0],
    "SunPosition": [0, 10, 0],
    "SunRotation": [50, -30, 0],
    "SunColor": [255, 255, 255],
    "SunAmbientColor": [180, 180, 180],
    "BackgroundColor": [34, 49, 63],
    "Gravity": [0, 0, 0],
    "SoundTrack": "",
    "CustomVariables": [
        {"name": "TypedTestPassed", "type": "bool", "boolValue": false}
    ],
    "Cast": [
        {
            "ActorName": "BlueTank",
            "Active": true,
            "PrefabName": "BlueTank",
            "Tag": "Untagged",
            "IconColorHex": "",
            "Position": [-4.0, 0.0, -2.0],
            "Rotation": [0.0, 0.0, 0.0],
            "Scale": [1.0, 1.0, 1.0],
            "CustomProperties": [
                {
                    "name": "Ammo",
                    "type": "int",
                    "intValue": 1,
                    "boolValue": false
                },
                {
                    "name": "Boost",
                    "type": "float",
                    "floatValue": 0.5,
                    "boolValue": false
                },
                {
                    "name": "Armed",
                    "type": "bool",
                    "boolValue": false
                },
                {
                    "name": "Offset",
                    "type": "vector2",
                    "boolValue": false,
                    "arrayValue": [
                        7.0,
                        1.0
                    ]
                },
                {
                    "name": "Goal",
                    "type": "vector3",
                    "boolValue": false,
                    "arrayValue": [0.0, 0.0, 1.0]
                },
                {
                    "name": "LegacyStep",
                    "type": "float",
                    "floatValue": 2.0,
                    "boolValue": false
                }
            ],
            "Script": [
                {
                    "Name": "1. Space writes typed values",
                    "When": [
                        "Keyboard(Space,down) AND NOT Check(this.Armed) AND Compare(this.LegacyStep == 2) AND Compare(this.Boost == 0.5)"
                    ],
                    "Do": [
                        "Edit(this.Ammo,2.6)",
                        "Edit(this.Boost,this.Boost+1)",
                        "Edit(this.Offset.x,this.Offset.x+1)",
                        "Edit(this.Goal.z,this.Goal.z+this.LegacyStep)",
                        "Edit(this.Armed,1)",
                        "Edit(#TypedTestPassed,1)"
                    ],
                    "groupId": "typed-blue"
                },
                {
                    "Name": "2. Verify changes and spawn the red tank",
                    "When": [
                        "Check(this.Armed) AND Check(#TypedTestPassed) AND Compare(this.Ammo == 3) AND Compare(this.Boost == 1.5) AND Compare(this.Offset.x == 8) AND Compare(this.Goal.z == 3)"
                    ],
                    "Do": [
                        "Spawn(RedTank,this,this.Offset.x,0,0,0,0,0)",
                        "Edit(this.z,this.Goal.z)",
                        "Edit(#TypedTestPassed,0)"
                    ],
                    "groupId": "typed-blue"
                }
            ],
            "Components": [
                {
                    "type": "Properties",
                    "name": "Custom Properties",
                    "id": ""
                },
                {
                    "type": "Rules",
                    "name": "Rules Set",
                    "id": "typed-blue"
                }
            ]
        },
        {
            "ActorName": "RedTank",
            "Active": false,
            "PrefabName": "RedTank",
            "Tag": "Untagged",
            "IconColorHex": "",
            "Position": [40.0, 0.0, 0.0],
            "Rotation": [0.0, 0.0, 0.0],
            "Scale": [1.0, 1.0, 1.0],
            "CustomProperties": [
                {
                    "name": "SpawnReady",
                    "type": "bool",
                    "boolValue": true
                },
                {
                    "name": "SpawnAmmo",
                    "type": "int",
                    "intValue": 4,
                    "boolValue": false
                },
                {
                    "name": "SpawnBoost",
                    "type": "float",
                    "floatValue": 0.75,
                    "boolValue": false
                },
                {
                    "name": "SpawnOffset",
                    "type": "vector2",
                    "boolValue": false,
                    "arrayValue": [
                        0.0,
                        1.5
                    ]
                },
                {
                    "name": "SpawnGoal",
                    "type": "vector3",
                    "boolValue": false,
                    "arrayValue": [0.0, 0.0, 2.5]
                }
            ],
            "Script": [
                {
                    "Name": "3. Verify spawned defaults and move to Z 4",
                    "When": [
                        "Check(this.SpawnReady) AND Compare(this.SpawnAmmo == 4) AND Compare(this.SpawnBoost == 0.75) AND Compare(this.SpawnOffset.y == 1.5) AND Compare(this.SpawnGoal.z == 2.5)"
                    ],
                    "Do": [
                        "Edit(this.z,this.SpawnGoal.z+this.SpawnOffset.y)",
                        "Edit(this.SpawnReady,0)"
                    ],
                    "groupId": "typed-red"
                }
            ],
            "Components": [
                {
                    "type": "Properties",
                    "name": "Custom Properties",
                    "id": ""
                },
                {
                    "type": "Rules",
                    "name": "Rules",
                    "id": "typed-red"
                }
            ]
        }
    ]
}