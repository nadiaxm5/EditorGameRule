{
    "Name": "SURVIVAL_SHOOTER",
    "CameraPosition": [0, 6, -7],
    "CameraRotation": [30, 0.0, 0.0],
    "SunPosition": [3.3899, 10.902, -5.8255],
    "SunRotation": [22.704, 65.875, -175.012],
    "SunColor": [195, 184, 255],
    "SunAmbientColor": [170, 180, 200],
    "Cast": [
        {
            "Name": "LightingReflection",
            "Prefab": "LightingReflection"
        },
        {
            "Name": "Environment",
            "Prefab": "Environment",
            "Tag":"Obstacle"
        },
        {
            "Name": "Player",
            "Prefab": "Player",
            "Tag":"Player",
            "Position": [0.0, 0.0, 0.0],
            "Properties": ["speed=5", "rotSpeed=360", "lastHealth=100.0", "health=100.0", "score=0", "desp=7", "despX=0.28", "despY=0.3", "despZ=0.7"],
            "Script": [
                {
                    "Do": ["RotateTo(MouseWorldX, MouseWorldY, MouseWorldZ, this.rotSpeed)", "Animate(0)", "Camera.x=this.x", "Camera.z=this.z-this.desp"]
                },
                {
                    "When": ["Keyboard(RightArrow,press)"],
                    "Do": ["Move(this.speed, 0, 90, 0)", "Animate(1)"]
                },
                {
                    "When": ["Keyboard(LeftArrow,press)"],
                    "Do": ["Move(this.speed, 0, -90, 0)", "Animate(1)"]
                },
                {
                    "When": ["Keyboard(UpArrow,press)"],
                    "Do": ["Move(this.speed, 0, 0, 0)", "Animate(1)"]
                },
                {
                    "When": ["Keyboard(DownArrow,press)"],
                    "Do": ["Move(this.speed, 0, 180, 0)", "Animate(1)"]
                },
                {
                    "When": ["Collision(Hellephant)"],
                    "Do": ["this.health=this.health-Hellephant.damage", "PlaySound(PlayerHurt)"]
                },
                {
                    "When": ["Collision(ZomBear)"],
                    "Do": ["this.health=this.health-ZomBear.damage", "PlaySound(PlayerHurt)"]
                },
                {
                    "When": ["Collision(ZomBunny)"],
                    "Do": ["this.health=this.health-ZomBunny.damage", "PlaySound(PlayerHurt)"]
                },
                {
                    "When":["Compare(this.health<0)"],
                    "Do":["GameOver.Active=1", "PlaySound(PlayerDeath)", "Animate(2)", "this.speed=0"]
                },
                {
                    "When":["Compare(this.health==this.lastHealth)"],
                    "Do":["DamageCanvas.Active=0"]
                },
                {
                    "When":["Compare(this.health<this.lastHealth)"],
                    "Do":["DamageCanvas.Active=1", "this.lastHealth=this.health"]
                },
                {
                    "When": ["Touch(press)"],
                    "Do": ["Spawn(Bullet, this, this.despX, this.despY, this.despZ)", "Spawn(Laser, this, this.despX, this.despY, this.despZ)", "ShotLight.Active=1", "PlaySound(PlayerGunShot)", "PlayParticles(GunBarrelEnd)"]
                }
            ]
        },
        {
            "Name": "Hellephant",
            "Prefab": "Hellephant",
            "Tag":"Hellephant",
            "Active": false,
            "Position": [0.0, 0.0, 32.0],
            "Rotation": [0.0, -130.0, 0.0],
            "Properties": ["speed=2", "health=300", "damage=0.3"],
            "Script": [
                {
                    "Do": ["Animate(0)", "NavigateTo(this.speed,Player.x,Player.y,Player.z)"]
                },
                {
                    "When":["Compare(Player.health<0)"],
                    "Do":["Animate(1)", "this.speed=0"]
                },
                {
                    "When": ["Collision(Bullet)"],
                    "Do": ["this.health=this.health-Bullet.damage", "PlaySound(HellephantHurt)", "PlayParticles(HitParticles)"]
                },
                {
                    "When": ["Compare(this.health<=0)"],
                    "Do": ["Player.score=Player.score+50", "Spawn(HellephantDead, this)", "Delete(this)"]
                }
            ]
        },
        {
