            ]
        },{
            "Name":"GameOver",
            "Prefab":"GameOver",
            "Active": false,
            "Properties":["counter=0"],
            "Script":[
                {
                    "Do": ["Animate(0)"]
                },
                {
                "When":["Compare(this.counter==100)"],
                "Do":["Animate(1)"]
                },
                {
                "When":["Compare(this.counter==150)"],
                "Do":["LoadScene()"]
                },{
                "When":["Compare(this.counter<=150)"],
                "Do":["this.counter=this.counter+1"]
                }
            ]
        }
