{
    "GameName": "TANKS",
    "ScreenResolution": [1920, 1080],
    "CameraPosition": [-12, 20, 5],
    "CameraRotation": [50, 60, 0],
    "SunPosition": [0, 10, 0],
    "SunRotation": [54.3, -26.2, 10.5],
    "SunColor": [225, 240, 250],
    "SunAmbientColor": [170, 180, 200],
    "BackgroundColor": [0, 0, 0],
    "Gravity": [0, -9.81, 0],
    "CustomVariables": [],
    "Cast": [
        {
            "ActorName": "LevelArt",
            "Active": true,
            "PrefabName": "LevelArt",
            "Tag": "Obstacle"
        },
        {
            "ActorName": "BlueTank",
            "Active": true,
            "PrefabName": "BlueTank",
            "Tag": "BlueTank",
            "Position": [-3.0, 0.0, 30.0],
            "Rotation": [0.0, 180.0, 0.0],
            "Velocity": [10.0, 0.0, 10.0],
            "AngularVelocity": [0.0, 90.0, 0.0],
            "Properties": [
                "speed=10",
                "angularSpeed=90",
                "health=100",
                "offsetY=1.7",
                "offsetZ=1.35",
                "maxAim=200",
                "currentAim=0"
            ],
            "Script": [
                {
                    "When": [
                        "Keyboard(D,press)"
                    ],
                    "Do": [
                        "Rotate(this.angularSpeed,this.rx,this.ry,this.rz)",
                        "PlayParticles(DustTrail)"
                    ]
                },
                {
                    "When": [
                        "Keyboard(A,press)"
                    ],
                    "Do": [
                        "Rotate(-this.angularSpeed,this.rx,this.ry,this.rz)",
                        "PlayParticles(DustTrail)"
                    ]
                },
                {
                    "When": [
                        "Keyboard(W,press)"
                    ],
                    "Do": [
                        "Move(this.speed,0,this.ry,0)"
                    ]
                },
                {
                    "When": [
                        "Keyboard(S,press)"
                    ],
                    "Do": [
                        "Move(this.speed,0,this.ry+180,0)"
                    ]
                },
                {
                    "When": [
                        "Collision(Shell)"
                    ],
                    "Do": [
                        "Edit(this.health,this.health-Shell.damage)",
                        "PushTo(-300,RedTank.x,RedTank.y,RedTank.z)"
                    ]
                },
                {
                    "When": [
                        "Compare(this.health<=0)"
                    ],
                    "Do": [
                        "Edit(RedWin.Active,1)"
                    ]
                },
                {
                    "When": [
                        "Keyboard(Space,press)"
                    ],
                    "Do": [
                        "Edit(this.currentAim,this.currentAim+1)",
                        "PlaySound(ShotCharging)"
                    ]
                },
                {
                    "When": [
                        "Compare(this.currentAim>=this.maxAim)"
                    ],
                    "Do": [
                        "Edit(this.currentAim,this.maxAim)"
                    ]
                },
                {
                    "When": [
                        "Keyboard(Space,up)"
                    ],
                    "Do": [
                        "Spawn(Shell,this,0,this.offsetY,this.offsetZ)",
                        "Edit(this.currentAim,0)",
                        "PlaySound(ShotFiring)"
                    ]
                }
            ]
        },
